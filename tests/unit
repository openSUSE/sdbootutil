# The addon of the root is current while its initrd has the crypttab
# that it would get now
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_dps_addon_crypttab()
{
	load
	local boot_root="$workdir/esp" entry_token=t tmpdir="$workdir/tmp" t_ct="cr_root"
	local out="$boot_root/loader/addons/t-dps.addon.efi"
	mkdir -p "${out%/*}" "$tmpdir"
	crypttab_cpio() { echo "$t_ct" > "$1"; }
	# The addon is its initrd here
	objcopy() { [ -e "$4" ] && cp "$4" "$5"; }

	dps_addon_crypttab_current && fail "current without the addon"
	echo "cr_root" > "$out"
	dps_addon_crypttab_current || fail "not current with the same crypttab"
	t_ct="cr_root cr_new"
	dps_addon_crypttab_current && fail "current after a new device"
	[ ! -e "$tmpdir/crypttab-now.cpio" ] && [ ! -e "$tmpdir/crypttab-addon.cpio" ] || fail "files left in $tmpdir"
	return 0
}

# The initrd of a UKI is made new, without the crypttab and the command
# line of the disks, and from a fixed path and time, as dracut keeps them
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_stage_initrd_uki()
{
	load
	local tmpdir="$workdir/tmp" have_snapshots='' verbose=''
	mkdir -p "$tmpdir" /var/lib/sdbootutil
	scratch_dir /var/lib/sdbootutil
	signing_epoch() { echo 1700000000; }
	reuse_initrd() { echo reused >> "$workdir/stage-log"; return 0; }
	dracut() { echo "$*" >> "$workdir/stage-log"; }
	stage_initrd 1 "" 7.3.5-1-default /nonexistent uki
	says "dracut" "$(cat "$workdir/stage-log")" "--no-hostonly-cmdline --include /var/lib/sdbootutil/uki-etc /etc"
	says_not "not reused" "$(cat "$workdir/stage-log")" "reused"
	[ -e /var/lib/sdbootutil/uki-etc/crypttab ] && [ ! -s /var/lib/sdbootutil/uki-etc/crypttab ] || fail "no empty crypttab"
	is "fixed time" 1700000000 "$(stat -c %Y /var/lib/sdbootutil/uki-etc/crypttab)"
	return 0
}

# The command line of the addon of a UKI entry: the "rootflags=" of the
# snapshot, and the options of the system only with UKI_CMDLINE="yes".
# Never "root=", that is in the addon of the root
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_uki_addon_cmdline()
{
	load
	local UKI_CMDLINE
	get_rootfs() { echo /dev/mapper/cr_root; }
	kernel_cmdline() { echo "quiet resume=/dev/mapper/cr_swap"; }

	UKI_CMDLINE=yes
	is "options" "quiet resume=/dev/mapper/cr_swap rootflags=subvol=@/.snapshots/5/snapshot" \
		"$(uki_addon_cmdline @/.snapshots/5/snapshot)"
	is "options, no snapshots" "quiet resume=/dev/mapper/cr_swap" "$(uki_addon_cmdline "")"
	UKI_CMDLINE=no
	is "no options" "rootflags=subvol=@/.snapshots/5/snapshot" "$(uki_addon_cmdline @/.snapshots/5/snapshot)"
	is "no options, no snapshots" "" "$(uki_addon_cmdline "")"
	return 0
}

# The UKI of an entry built here is used again when `reusable_uki`
# finds it, and the entry is linked again anyway, as its addon can
# change without the UKI (see `link_uki`)
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_install_local_uki_kept()
{
	load
	local boot_root="$workdir/esp" entry_token=t tmpdir="$workdir/tmp" arg_force='' arg_no_reuse_initrd='' t_reused
	mkdir -p "$boot_root/t" "$boot_root/loader/entries" "$tmpdir"
	echo "uki /t/uki.efi" > "$boot_root/loader/entries/t-commit_5.5.7.3.4-1-default.conf"
	touch "$boot_root/t/uki.efi"
	reusable_uki() { [ -n "$t_reused" ] && echo "$boot_root/loader/entries/t-commit_5.5.7.3.4-1-default.conf"; }
	stage_initrd() { :; }
	build_uki() { :; }
	stage_hashed() { touch "$tmpdir/u.efi"; echo "$tmpdir/u.efi"; }
	link_uki() { [ -e "$4" ] && echo "link $4"; }
	t_reused=1
	is "reused" "link $tmpdir/uki.efi" "$(install_local_uki 5 @/.snapshots/5/snapshot 7.3.4-1-default "$workdir/vmlinuz" 2> /dev/null)"
	t_reused=
	is "new" "link $tmpdir/u.efi" "$(install_local_uki 5 @/.snapshots/5/snapshot 7.3.4-1-default "$workdir/vmlinuz" 2> /dev/null)"
	t_reused=1 arg_force=1
	is "forced" "link $tmpdir/u.efi" "$(install_local_uki 5 @/.snapshots/5/snapshot 7.3.4-1-default "$workdir/vmlinuz" 2> /dev/null)"
	return 0
}

# The entries of a snapshot and of this system include the ones made by
# "bootctl link" (<token>-commit_<snapshot>.<version>.conf, no options)
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_entries_linked()
{
	load
	local entryfile="$workdir/entries.json" entry_token=opensuse-tumbleweed subvol_prefix=@
	get_all_rootfs() { echo "/dev/mapper/cr_root"; }
	bootctl_entries()
	{
		jq -n '[
			{id: "opensuse-tumbleweed-6.1.0-1-default-5.conf",
			 options: "root=/dev/mapper/cr_root rootflags=subvol=@/.snapshots/5/snapshot"},
			{id: "opensuse-tumbleweed-commit_5.6.2.0-1-default.conf", type: "type1", uki: "/opensuse-tumbleweed/uki-a.efi"},
			{id: "opensuse-tumbleweed-commit_50.6.2.0-1-default.conf", type: "type1", uki: "/opensuse-tumbleweed/uki-a.efi"},
			{id: "other-commit_5.6.2.0-1-default.conf", type: "type1", uki: "/other/uki-b.efi"},
			{id: "other-6.1.0-1-default-5.conf", options: "root=/dev/sdz1 rootflags=subvol=@/.snapshots/5/snapshot"},
			{id: "opensuse-tumbleweed-commit_5@1+3.conf", type: "type1", uki: "/opensuse-tumbleweed/uki-c.efi"},
			{id: "opensuse-tumbleweed-commit_5.6.1.0-1-default.conf", type: "loader"}
		]'
	}

	update_entries_for_snapshot 5
	is "snapshot 5" "opensuse-tumbleweed-6.1.0-1-default-5.conf opensuse-tumbleweed-commit_5.6.2.0-1-default.conf opensuse-tumbleweed-commit_5@1+3.conf" \
	   "$(jq -r '.[].id' "$entryfile" | paste -sd ' ')"
	update_entries_for_this_system
	is "this system" "4" "$(jq length "$entryfile")"
	is "snapshot of a linked entry" "50" "$(entry_snapshot opensuse-tumbleweed-commit_50.6.2.0-1-default.conf < "$entryfile")"
