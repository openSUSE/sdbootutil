	is_transactional() { false; }
	default_entry_snapshot() { echo 7; }
	jq -n '{root: [{number: 5, active: true, date: "2026-01-01"}, {number: 7, default: true, date: "2026-01-03"},
		       {number: 9, date: "2026-01-05"}, {number: 8, date: "2026-01-04"}]}' > "$snapperfile"
