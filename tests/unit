#!/bin/bash
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: Copyright 2026 SUSE LLC
#
# Unit tests for the library half of sdbootutil: the routing of the
# secrets -- which source wins, what is published to the keyring, and
# which warnings are printed -- the entry names the boot loaders spell
# differently, the versions the status report compares, `grubenv`, the
# entries that may be removed to make room in the ESP, and the files of
# the ESP that may reach a TPM2 policy.
#
# These are decisions the tool takes *before* it writes anything to the
# TPM2, so they do not need one, and they do not need a guest either: a
# scratch LUKS2 container on a loop device answers `cryptsetup` and
# `systemd-cryptenroll` exactly like a real root device does.  What
# cannot be reached from here is everything about the pcrlock NVIndex
# (authorizing with the old PIN, the "not needed, so not validated"
# skip); that needs a real TPM2 and destroys the enrollment of the
# machine it runs on, so it belongs to a guest and not to this file.
#
# `tests/run` drives the boot and FDE state of a whole guest and never
# writes outside a copy of the ESP.  This one is the opposite: it writes
# LUKS2 headers, but only the ones it made itself.
#
# Usage:
#   tests/unit [-h]
#
# Needs root, for losetup and for the keyring.  The entries it uses are
# the real ones -- the names are in the code -- so it refuses to start
# when one of them is already there, rather than overwrite a secret that
# an installer or an interrupted enrollment left behind.

set -e
shopt -s nullglob

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
top="$(dirname "$here")"

# The password of the scratch container, and the credential that
# authorizes every enrollment below
BOOTSTRAP="bootstrap-password"

# The keyring entries sdbootutil reads or writes.  Purged between cases
# so that one cannot inherit what the one before it left
KEYS=(cryptenroll sdbootutil sdbootutil-key sdbootutil-pw sdbootutil-pin
      sdbootutil-recovery-pin sdbootutil-tpm2-pin)

# A boot entry ID as `bootctl` reports it, for the entry_key cases
ENTRY="opensuse-microos-7.2.3-1-default-10"

[ "${1:-}" != "-h" ] && [ "${1:-}" != "--help" ] || {
	sed -n '4,27p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
	exit 0
}

skip()
{
	echo "SKIP: $*"
	exit 77
}

die()
{
	echo "ERROR: $*" >&2
	exit 1
}

[ "$(id -u)" = 0 ] || skip "needs root for losetup and the keyring"
for cmd in cryptsetup systemd-cryptenroll keyctl losetup jq; do
	command -v "$cmd" > /dev/null || skip "$cmd is not installed"
done
for key in "${KEYS[@]}"; do
	keyctl id %user:"$key" &> /dev/null && \
		die "%user:$key is in the keyring. Purge it first: keyctl purge user $key"
done

# The PCR 15 cases read and write fixed paths of the host (/etc/crypttab,
# /var/lib/sdbootutil, /var/lib/pcrlock.d, the measurement log).  They
# put scratch mounts over them, so everything runs in a mount namespace
# of its own, and nothing reaches the host
if [ -z "${SDBOOTUTIL_UNIT_NS:-}" ]; then
	command -v unshare > /dev/null || skip "unshare is not installed"
	exec env SDBOOTUTIL_UNIT_NS=1 unshare --mount --propagation private "${BASH_SOURCE[0]}" "$@"
fi

# The library half of sdbootutil.  Everything below the marker is the
# command dispatcher, which would run on source; everything above it is
# definitions, and the marker is already there for the completion data
lib=
dev=
workdir="$(mktemp -d -t sdbootutil-unit.XXXXXX)"

cleanup_unit()
{
	[ -z "$dev" ] || losetup -d "$dev" 2> /dev/null || true
	rm -rf "$workdir"
	purge_keys
}
trap cleanup_unit EXIT

purge_keys()
{
	local key
	for key in "${KEYS[@]}"; do
		keyctl purge user "$key" &> /dev/null || true
	done
}

extract_lib()
{
	grep -q '^####### main #######$' "$top/sdbootutil" || \
		die "the 'main' marker is gone from sdbootutil, nothing to source"
	lib="$workdir/lib.sh"
	sed '/^####### main #######$/,$d' "$top/sdbootutil" > "$lib"
	# shellcheck source=/dev/null
	( . "$lib" ) || die "the library half of sdbootutil does not source cleanly"
}

# A fresh LUKS2 header for every case, so that the slots of one do not
# reach the next.  pbkdf2 with the lowest iteration count keeps a format
# under a tenth of a second; nothing here measures key derivation
format_device()
{
	cryptsetup luksFormat --type luks2 --batch-mode \
		   --pbkdf pbkdf2 --pbkdf-force-iterations 1000 \
		   "$dev" <<<"$BOOTSTRAP"
}

setup_device()
{
	truncate -s 32M "$workdir/luks.img"
	dev="$(losetup --find --show "$workdir/luks.img")"
}

####### the assertions #######
#
# They report and continue, so that one case tells the whole story
# instead of only its first mistake.  `case_failed` is a plain variable
# because every case runs in its own subshell

fail()
{
	echo "     $*"
	case_failed=1
}

is()
{
	[ "$2" = "$3" ] || fail "$1: expected '$2', got '$3'"
}

says()
{
	case "$2" in
		*"$3"*) ;;
		*) fail "$1: '$3' was not said" ;;
	esac
}

# The content of the section NAME of the PE file FILE.  Not through
# /dev/stdout: objcopy renames a new file over its output
pe_section_text()
{
	objcopy -O binary --only-section="$2" "$1" "$workdir/section"
	cat "$workdir/section"
	rm -f "$workdir/section"
}

says_not()
{
	case "$2" in
		*"$3"*) fail "$1: '$3' was said, and should not" ;;
	esac
}

key_is()
{
	local id value=
	if id="$(keyctl id %user:"$1" 2> /dev/null)"; then
		value="$(keyctl pipe "$id")"
	fi
	is "keyring %user:$1" "$2" "$value"
}

no_key()
{
	! keyctl id %user:"$1" &> /dev/null || \
		fail "keyring %user:$1 exists, and should not"
}

opens()
{
	cryptsetup luksOpen --test-passphrase --disable-external-tokens \
		   "$dev" <<<"$1" &> /dev/null || \
		fail "$2: the value does not open the device"
}

# Run "$@" with the trace of --start-trace-code going to $workdir/trace,
# as sdbootutil does it: `set -x` on a separate descriptor
traced()
{
	local fd
	: > "$workdir/trace"
	exec {fd}>> "$workdir/trace"
	BASH_XTRACEFD="$fd"
	set -x
	"$@"
	{ set +x; } 2> /dev/null
	unset BASH_XTRACEFD
	exec {fd}>&-
}

# None of the values reached the trace
not_traced()
{
	local value
	[ -s "$workdir/trace" ] || fail "trace: nothing was traced, the check proves nothing"
	for value in "$@"; do
		[ -n "$value" ] || continue
		! grep -qF -- "$value" "$workdir/trace" || \
			fail "trace: a secret was recorded ('${value:0:6}...')"
	done
}

# Source the library with whatever the case put in the environment, and
# take back the `set -e` that sdbootutil turns on: an assertion has to
# be able to fail without ending the case
load()
{
	# shellcheck source=/dev/null
	. "$lib"
	set +e
	# grubenv_set and the installers record into it, never the host's
	# shellcheck disable=SC2034  # read by the sourced library
	esp_files="$workdir/esp-files"
}

# An empty tmpfs over "dir", for the cases that use a fixed path of the
# host.  Only our own tmpfs is emptied: "dir" can be a mount point of the
# host (/.snapshots is one), and its files are not ours
scratch_dir()
{
	local dir="$1"

	# The last one is on top of the ones of the host
	scratch_mounted() { [ "$(findmnt -n -o SOURCE --mountpoint "$dir" | tail -1)" = sdbootutil-unit ]; }
	scratch_mounted || mount -t tmpfs sdbootutil-unit "$dir"
	scratch_mounted || die "$dir is not a scratch tmpfs"
	rm -rf "${dir:?}"/*
}

####### the cases #######
#
# get_device_password: every source of a *current* password, and the
# rule that a candidate is validated before it is used

t_gdp_current_pw()
{
	CURRENT_PW="$BOOTSTRAP" load

	get_device_password "$dev"
	# shellcheck disable=SC2154  # set by the sourced library
	is "returned" "$BOOTSTRAP" "$device_pw"
	key_is cryptenroll "$BOOTSTRAP"
}

t_gdp_key()
{
	KEY="$BOOTSTRAP" load

	get_device_password "$dev"
	is "returned" "$BOOTSTRAP" "$device_pw"
}

t_gdp_pw()
{
	PW="$BOOTSTRAP" load

	get_device_password "$dev"
	is "returned" "$BOOTSTRAP" "$device_pw"
}

# The recovery PIN is the recovery key while the two are linked, so the
# variable has to unlock exactly like its keyring twin below
t_gdp_recovery_pin()
{
	RECOVERY_PIN="$BOOTSTRAP" load

	get_device_password "$dev"
	is "returned" "$BOOTSTRAP" "$device_pw"
}

t_gdp_keyring_recovery_pin()
{
	load
	keyctl padd user sdbootutil-recovery-pin @u <<<"$BOOTSTRAP" > /dev/null

	get_device_password "$dev"
	is "returned" "$BOOTSTRAP" "$device_pw"
}

# %user:sdbootutil holds "any secret" and is deprecated as a name, but
# not as a candidate: it is validated like the rest
t_gdp_keyring_deprecated()
{
	load
	keyctl padd user sdbootutil @u <<<"$BOOTSTRAP" > /dev/null

	get_device_password "$dev"
	is "returned" "$BOOTSTRAP" "$device_pw"
}

t_gdp_all_wrong()
{
	CURRENT_PW="wrong-1" KEY="wrong-2" PW="wrong-3" RECOVERY_PIN="wrong-4" load

	get_device_password "$dev"
	is "returned" "" "$device_pw"
	# A wrong candidate must not displace a good entry, so nothing
	# is written when nothing validated
	no_key cryptenroll
}

t_gdp_wrong_then_valid()
{
	CURRENT_PW="wrong-1" KEY="$BOOTSTRAP" load

	get_device_password "$dev"
	is "returned" "$BOOTSTRAP" "$device_pw"
	key_is cryptenroll "$BOOTSTRAP"
}

####### enroll_recovery_key: what is enrolled, and what is published
####### as the recovery PIN

t_erk_key_env()
{
	CURRENT_PW="$BOOTSTRAP" KEY="the-recovery-key" load
	# No policy of the host, that would have a PIN
	scratch_dir /var/lib/systemd
	local -x TMPDIR="$workdir/keyfiles"
	mkdir -p "$TMPDIR"

	out="$(enroll_recovery_key "$dev" 2>&1)"

	opens "the-recovery-key" "enrolled key"
	# No PIN anywhere, so this key becomes one: a single secret
	key_is sdbootutil-recovery-pin "the-recovery-key"
	says_not "output" "$out" "are now different"
	# The key never goes through a file
	is "key files" "" "$(ls -A "$TMPDIR")"
}

# Nothing was given: systemd-cryptenroll generates the key, it is
# printed, and it is published as the recovery PIN too
t_erk_generated()
{
	CURRENT_PW="$BOOTSTRAP" load
	scratch_dir /var/lib/systemd

	out="$(enroll_recovery_key "$dev" 2>&1)"

	local key
	key="$(sed -n 's/^Recovery key: //p' <<<"$out")"
	[ -n "$key" ] || fail "output: no recovery key was printed"
	opens "$key" "generated key"
	key_is sdbootutil-recovery-pin "$key"
}

# A recovery PIN is presented and there is no recovery key yet, so the
# key enrolled is the PIN: still one secret, and the entry that holds
# the PIN is not rewritten
t_erk_recovery_pin_env()
{
	CURRENT_PW="$BOOTSTRAP" RECOVERY_PIN="the-recovery-pin" load

	out="$(enroll_recovery_key "$dev" 2>&1)"

	opens "the-recovery-pin" "enrolled key"
	says_not "output" "$out" "are now different"
}

# Both given and different: the key is enrolled, the PIN is left alone
# (it cannot be replaced) and the divergence is reported
t_erk_diverging()
{
	CURRENT_PW="$BOOTSTRAP" KEY="the-recovery-key" RECOVERY_PIN="the-recovery-pin" load

	out="$(enroll_recovery_key "$dev" 2>&1)"

	opens "the-recovery-key" "enrolled key"
	says "output" "$out" "The recovery key and the recovery PIN are now different"
	no_key sdbootutil-recovery-pin
}

# A PIN already seals an NVIndex and it is not reachable here, so this
# key is not it.  Publishing it would name as the recovery PIN a value
# that no policy update can use, and `status` would then report a PIN
# that is not there (github issue 250).  The TPM2 slot is faked because
# the answer must not depend on having a TPM2
t_erk_unreachable_pin()
{
	CURRENT_PW="$BOOTSTRAP" KEY="the-recovery-key" load

	# Called by enroll_recovery_key, from the sourced library
	# shellcheck disable=SC2329
	have_slot()
	{
		[ "$2" = "tpm2" ] && return 0
		grep -q "$2" < <(systemd-cryptenroll "$1")
	}

	out="$(enroll_recovery_key "$dev" 2>&1)"

	opens "the-recovery-key" "enrolled key"
	says "output" "$out" "There is already a recovery PIN for the TPM2"
	says "output" "$out" "The recovery key and the recovery PIN are now different"
	no_key sdbootutil-recovery-pin
}

# The NVIndex is one for every device: a TPM2 slot in another device,
# or a policy, means that a PIN already seals it, and this key is not it
t_erk_shared_nvindex()
{
	CURRENT_PW="$BOOTSTRAP" KEY="the-recovery-key" load
	scratch_dir /var/lib/systemd
	# shellcheck disable=SC2034  # read by the sourced library
	local tracked_devices=("$dev" /dev/other)
	# Called by enroll_recovery_key, from the sourced library
	# shellcheck disable=SC2329
	have_slot()
	{
		[ "$1" = /dev/other ] && [ "$2" = "tpm2" ] && return 0
		[ "$1" != /dev/other ] && grep -q "$2" < <(systemd-cryptenroll "$1")
	}

	out="$(enroll_recovery_key "$dev" 2>&1)"
	opens "the-recovery-key" "enrolled key"
	says "TPM2 in another device" "$out" "There is already a recovery PIN for the TPM2"
	no_key sdbootutil-recovery-pin

	tracked_devices=("$dev")
	echo '{}' > /var/lib/systemd/pcrlock.json
	out="$(enroll_recovery_key "$dev" 2>&1)"
	says "policy" "$out" "There is already a recovery PIN for the TPM2"
	no_key sdbootutil-recovery-pin
}

# A key that could not be set is not published as the recovery PIN
t_erk_change_fails()
{
	CURRENT_PW="$BOOTSTRAP" KEY="the-recovery-key" load
	scratch_dir /var/lib/systemd
	# Called by enroll_recovery_key, from the sourced library
	# shellcheck disable=SC2329
	cryptsetup()
	{
		[ "$1" != luksChangeKey ] || return 1
		command cryptsetup "$@"
	}

	enroll_recovery_key "$dev" &> /dev/null && fail "the enrollment succeeded"
	no_key sdbootutil-recovery-pin
	is "no slot of an unknown key" "" "$(systemd-cryptenroll "$dev" | grep recovery)"
}

# A new recovery key replaces the old one only once it opens the device
t_erk_replace()
{
	CURRENT_PW="$BOOTSTRAP" KEY="the-old-key" load
	scratch_dir /var/lib/systemd
	enroll_recovery_key "$dev" &> /dev/null || fail "the first enrollment failed"

	# shellcheck disable=SC2034  # read by the sourced library
	env_key="the-new-key"
	# Called by enroll_recovery_key, from the sourced library
	# shellcheck disable=SC2329
	cryptsetup()
	{
		[ "$1" != luksChangeKey ] || return 1
		command cryptsetup "$@"
	}
	enroll_recovery_key "$dev" &> /dev/null && fail "the failed enrollment succeeded"
	opens "the-old-key" "failed: the old key"
	is "failed: one recovery slot" 1 "$(systemd-cryptenroll "$dev" | grep -c recovery)"

	unset -f cryptsetup
	enroll_recovery_key "$dev" &> /dev/null || fail "the second enrollment failed"
	opens "the-new-key" "the new key"
	command cryptsetup luksOpen --test-passphrase --disable-external-tokens "$dev" <<<"the-old-key" &> /dev/null && \
		fail "the old key still opens the device"
	is "one recovery slot" 1 "$(systemd-cryptenroll "$dev" | grep -c recovery)"
}

# A TPM2 slot bound to PCR 15 in the initrd cannot authorize a new slot
# on the running system, so it is not used to unlock.  One bound after
# the initrd can
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_can_unlock_bound()
{
	load
	local binding the_anchor initrd
	tpm2_slot_binding() { echo "$binding"; }
	measure_anchor() { echo "$the_anchor"; }
	initrd_crypttab() { echo "$initrd"; }
	slot_is_unattended() { :; }
	have_slot() { :; }

	binding=bound the_anchor="$dev" initrd='' initrd_crypttab_read=''
	can_unlock "$dev" tpm2 2> /dev/null && fail "the anchor unlocks"
	binding=bound the_anchor=/dev/the-anchor initrd="cr_b $dev none" initrd_crypttab_read=''
	can_unlock "$dev" tpm2 2> /dev/null && fail "a device of the initrd unlocks"
	binding=bound the_anchor=/dev/the-anchor initrd='' initrd_crypttab_read=''
	can_unlock "$dev" tpm2 2> /dev/null || fail "a device after the initrd does not unlock"
	binding=bound+plain the_anchor="$dev" initrd_crypttab_read=''
	can_unlock "$dev" tpm2 2> /dev/null || fail "an unbound slot does not unlock"
	return 0
}

# The id of the top entry is all that get_top_entry_id prints, also
# when it has to install the kernels first
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_top_entry_install()
{
	load
	local entryfile="$workdir/entries.json" installed=''
	update_entries_for_snapshot()
	{
		if [ -n "$installed" ]; then echo '[{"id": "t-6.2.1-1-default-5.conf"}]'; else echo '[]'; fi > "$entryfile"
	}
	install_all_kernels() { installed=1; echo "MOK password: 12345678"; }
	is "id" "t-6.2.1-1-default-5.conf" "$(get_top_entry_id 5 2> /dev/null)"
	says "shown" "$(get_top_entry_id 5 2>&1 > /dev/null)" "MOK password: 12345678"
	return 0
}

# The anchor is the first encrypted device behind the root file system,
# also when --devices names only some of the devices
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_measure_anchor_devices()
{
	load
	local tracked_devices=(/dev/mapper/y)
	findmnt() { echo "1234"; }
	lsblk()
	{
		case "$*" in
			*"UUID =="*) printf '%s\n' /dev/mapper/cr_x /dev/mapper/cr_y ;;
			*cr_x) printf '%s\n' "/dev/mapper/cr_x btrfs" "/dev/vda2 crypto_LUKS" ;;
			*cr_y) printf '%s\n' "/dev/mapper/cr_y btrfs" "/dev/vda3 crypto_LUKS" ;;
		esac
	}
	cryptsetup() { [ "$1" = isLuks ]; }
	is_tracked_device() { :; }
	is "anchor" "/dev/vda2" "$(measure_anchor)"
	is_tracked_device() { [ "$1" != /dev/vda2 ]; }
	is "the first is ignored" "/dev/vda3" "$(measure_anchor)"
	return 0
}

# get_top_entry_id does not install every kernel when bootctl fails:
# that is not an empty ESP
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_top_entry_bootctl_fails()
{
	load
	local entryfile="$workdir/entries.json"
	update_entries_for_snapshot() { echo '[]' > "$entryfile"; }
	bootctl_entries() { return 1; }
	install_all_kernels() { echo installed; }
	local out
	out="$( (get_top_entry_id 5) 2>&1)" && fail "it succeeded"
	says_not "no installation" "$out" "installed"
	return 0
}

# entry_snapshot finds the entry also when the id has no ".conf" (as
# grub2-bls writes it) or has a boot counter
t_entry_snapshot_id()
{
	load
	local entries='[{"id": "t-6.2.1-1-default-5.conf", "version": "5_6.2.1-1-default"}]'
	is "id" "5" "$(entry_snapshot t-6.2.1-1-default-5.conf <<<"$entries")"
	is "no .conf" "5" "$(entry_snapshot t-6.2.1-1-default-5 <<<"$entries")"
	is "counter" "5" "$(entry_snapshot t-6.2.1-1-default-5+2-1.conf <<<"$entries")"
	is "another" "" "$(entry_snapshot t-6.2.1-1-default-6 <<<"$entries")"
	return 0
}

# update_entry_conf writes the options once, also when they have "&"
# or "|", and the entry had more than one options line
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_update_entry_conf()
{
	load
	local tmpdir="$workdir/tmp" have_snapshots=1 subvol_prefix=@
	mkdir -p "$tmpdir"
	printf 'title T\noptions root=UUID=1 quiet\noptions splash\nlinux /t/linux-1\n' > "$workdir/e.conf"
	create_boot_options() { echo 'root=UUID=1 a=x&y b=c|d'; }
	update_entry_conf "$workdir/e.conf" 5
	is "entry" "$(printf 'title T\noptions    root=UUID=1 a=x&y b=c|d\nlinux /t/linux-1')" "$(cat "$workdir/e.conf")"
	return 0
}

# update_entry and update_all_entries install the kernel again for a
# UKI, as its options are in the addon of its entry, but only when the
# UKIs are selected
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_update_entry_uki()
{
	load
	local TRANSACTIONAL_UPDATE='' entryfile="$workdir/entries.json" t_uki=local
	local -A found_kernels
	settle_entry_token() { :; }
	make_free_space() { :; }
	update_entries_for_snapshot() { :; }
	update_entry_conf() { echo "options $1"; }
	uki_selected() { [ -n "$t_uki" ]; }
	find_conf_file() { [ "$1" = 6.2.1-1-default ] || [ "$1" = 7.4.0-1-default ] && echo "$workdir/e.conf"; }
	linked_entry_ids() { [ "$1" = 7.3.5-1-default ] || [ "$1" = 7.4.0-1-default ] && echo "t-commit_5.5.$1.conf"; }
	find_kernels() { found_kernels=([6.2.1-1-default]=a [7.3.5-1-default]=b); }
	install_kernel() { echo "install $2"; }
	touch "$workdir/e.conf"
	echo '[{"path": "e.conf"}]' > "$entryfile"

	is "kernel and initrd" "options $workdir/e.conf" "$(update_entry 5 6.2.1-1-default 2> /dev/null)"
	is "UKI" "install 7.3.5-1-default" "$(update_entry 5 7.3.5-1-default 2> /dev/null)"
	is "UKI and the old entry" "install 7.4.0-1-default|options $workdir/e.conf" "$(update_entry 5 7.4.0-1-default 2> /dev/null | paste -sd '|')"
	is "no entry" "" "$(update_entry 5 7.5.0-1-default 2> /dev/null)"
	is "all" "options e.conf|install 7.3.5-1-default" "$(update_all_entries 5 2> /dev/null | paste -sd '|')"

	t_uki=""
	is "UKI, not selected" "" "$(update_entry 5 7.3.5-1-default 2> /dev/null)"
	is "all, not selected" "options e.conf" "$(update_all_entries 5 2> /dev/null | paste -sd '|')"
	return 0
}

# rewrite_old_entry_versions writes "N_" instead of "N@" in the version
# of the entries of this system, records them, and asks for new
# predictions.  Other lines, other entries and other systems stay
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_rewrite_old_entry_versions()
{
	load
	local boot_root="$workdir/esp-rewrite" entry_token=t tmpdir="$workdir/tmp" update_predictions=
	local e="$workdir/esp-rewrite/loader/entries"
	mkdir -p "$e" "$tmpdir"
	settle_entry_token() { :; }
	record_esp_file() { echo "${1##*/}" >> "$workdir/rewrite-recorded"; }
	printf 'title T\nversion    5@6.2.1-1-default\noptions a@b\n' > "$e/t-6.2.1-1-default-5.conf"
	printf 'title T\nversion    6@6.2.1-1-default\n' > "$e/t-6.2.1-1-default-6+2-1.conf"
	printf 'title T\nversion    7_6.2.1-1-default\n' > "$e/t-6.2.1-1-default-7.conf"
	printf 'title O\nversion    5@6.2.1-1-default\n' > "$e/other-6.2.1-1-default-5.conf"

	rewrite_old_entry_versions 5 2> /dev/null
	is "old" "$(printf 'title T\nversion    5_6.2.1-1-default\noptions a@b')" "$(cat "$e/t-6.2.1-1-default-5.conf")"
	is "with a boot counter" "$(printf 'title T\nversion    6_6.2.1-1-default')" "$(cat "$e/t-6.2.1-1-default-6+2-1.conf")"
	is "another system" "$(printf 'title O\nversion    5@6.2.1-1-default')" "$(cat "$e/other-6.2.1-1-default-5.conf")"
	is "recorded" "t-6.2.1-1-default-5.conf t-6.2.1-1-default-6+2-1.conf" "$(sort "$workdir/rewrite-recorded" | paste -sd ' ')"
	is "predictions" 1 "$update_predictions"

	update_predictions=
	rewrite_old_entry_versions 5 2> /dev/null
	is "once" "" "$update_predictions"
	return 0
}

# remove_kernel changes the default entry only when it removed it
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_remove_kernel_default()
{
	load
	local TRANSACTIONAL_UPDATE='' default
	settle_entry_token() { :; }
	entry_conf_file() { echo "t-$1-$2.conf"; }
	linked_entry_ids() { :; }
	entry_file() { :; }
	bootctl_entries() { :; }
	get_default_entry() { echo "$default"; }
	get_default_bootctl() { echo "t-new.conf"; }
	set_default_entry() { echo "default $1"; }
	default="t-6.2.1-1-default-5.conf"
	is "another kernel" "" "$(remove_kernel 5 6.3.0-1-default 2> /dev/null)"
	is "the default" "default t-new.conf" "$(remove_kernel 5 6.2.1-1-default 2> /dev/null)"
	return 0
}

# unlink_replaced_entry removes the entries of the kernel of another
# kind than the new one, but not the booted one, and moves the default
# to the new one
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_unlink_replaced_entry()
{
	load
	local boot_root="$workdir/esp" entry_token=t t_default t_selected
	local e="$boot_root/loader/entries" k=7.3.5-1-default
	local type1 local_uki generic virt
	mkdir -p "$e"
	type1="$(entry_conf_file "$k" 5)"
	local_uki="t-commit_5.5.$k.conf" generic="t-commit_5.5.$k.generic.conf" virt="t-commit_5.5.$k.virt.conf"
	get_default_entry() { echo "$t_default"; }
	bli_efi_var_get() { echo "$t_selected"; }
	bootctl_entries() { [ "$1" != unlink ] || rm -f "$e/$2"; }
	set_default_entry() { echo "default $1" >> "$workdir/unlink-log"; }
	t_entries() { touch "$e/$type1" "$e/$local_uki" "$e/$generic" "$e/$virt"; }
	t_left() { (cd "$e" && printf '%s\n' * | sort | paste -sd ' '); }

	t_entries; t_default="" t_selected=""
	unlink_replaced_entry "$k" 5 "$type1"
	is "kernel and initrd" "$type1" "$(t_left)"
	t_entries
	unlink_replaced_entry "$k" 5 "$local_uki"
	is "local UKI" "$local_uki" "$(t_left)"
	t_entries
	unlink_replaced_entry "$k" 5 "$generic"
	is "UKIs of the packages" "$generic $virt" "$(t_left)"

	# The booted one stays, the default moves
	t_entries; t_selected="$local_uki" t_default="$type1"
	unlink_replaced_entry "$k" 5 "$generic"
	is "booted" "$local_uki $generic $virt" "$(t_left)"
	is "default" "default $generic" "$(cat "$workdir/unlink-log")"

	# Also when the default is the booted one, that stays
	rm -f "$workdir/unlink-log"
	t_entries; t_selected="$type1" t_default="$type1"
	unlink_replaced_entry "$k" 5 "$local_uki"
	is "booted default" "$type1 $local_uki" "$(t_left)"
	is "default of the booted" "default $local_uki" "$(cat "$workdir/unlink-log" 2> /dev/null)"
	return 0
}

# entry_key: the spellings a boot loader can leave in
# "LoaderEntrySelected", all reduced to the ID that `bootctl` reports.
# systemd-boot writes that ID as it is; grub2-bls drops the ".conf"
# suffix and keeps the boot counter, which it records before
# "systemd-bless-boot" renames the file

t_ek_systemd_boot()
{
	load

	is "the ID itself" "$ENTRY" "$(entry_key "$ENTRY.conf")"
}

t_ek_no_suffix()
{
	load

	is "no .conf suffix" "$ENTRY" "$(entry_key "$ENTRY")"
}

t_ek_counter()
{
	load

	is "counter alone" "$ENTRY" "$(entry_key "$ENTRY+3")"
	is "counter and suffix" "$ENTRY" "$(entry_key "$ENTRY+3.conf")"
}

t_ek_counted_boot()
{
	load

	is "one attempt counted" "$ENTRY" "$(entry_key "$ENTRY+2-1")"
}

t_ek_not_a_counter()
{
	load

	# Only "+" followed by digits is a counter, so an entry token
	# that carries one keeps it
	is "a + in the name" "my+entry-1" "$(entry_key "my+entry-1.conf")"
	is "nothing to reduce" "" "$(entry_key "")"
}

