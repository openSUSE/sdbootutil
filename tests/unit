}

# remove_pcr and policy_missing_pcrs work on the comma lists of PCRs
# shellcheck disable=SC2034  # read by the sourced library
t_pcr_lists()
{
	load
	is "middle" "4,9" "$(remove_pcr 4,7,9 7)"
	is "first" "7,9" "$(remove_pcr 4,7,9 4)"
	is "last" "4,7" "$(remove_pcr 4,7,9 9)"
	is "absent" "4,7,9" "$(remove_pcr 4,7,9 1)"
	is "similar" "11,4" "$(remove_pcr 11,1,4 1)"
	is "alone" "" "$(remove_pcr 9 9)"
	scratch_dir /var/lib/systemd
	is "no policy" "" "$(policy_missing_pcrs 4,7,9)"
	echo '{"pcrValues": [{"pcr": 4}, {"pcr": 7}]}' > /var/lib/systemd/pcrlock.json
	is "missing" "9" "$(policy_missing_pcrs 4,7,9)"
	is "none missing" "" "$(policy_missing_pcrs 4,7)"
	is "extra" "7" "$(policy_extra_pcrs 4)"
	is "none extra" "" "$(policy_extra_pcrs 4,7,9)"
	return 0
}

# snapshot_ids_for_prediction: the running snapshot, the default entry,
# the default and active snapshots of snapper, without repeats, and the
# newest ones up to three
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_snapshot_ids_for_prediction()
{
	load
