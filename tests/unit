# find_conf_file finds the file of the entry of a kernel by its name,
# with or without a boot counter
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_find_conf_file()
{
	load
	local boot_root="$workdir/esp" entry_token=t have_snapshots=1
	is_grub2_bls() { false; }
	mkdir -p "$boot_root/loader/entries"
