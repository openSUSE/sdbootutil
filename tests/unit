# unenroll_device wipes the slot kind of the method, and names the
# methods of the device when the method is not known
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_unenroll_device()
{
	load
	local arg_method m strict_vars="arg_method"
	have_slot() { false; }
	systemd-cryptenroll() { [ "$1" != /dev/x ] || { printf '  0 password\n  1 tpm2\n'; return 0; }; echo "$*" >> "$workdir/wipe"; }
	: > "$workdir/wipe"
	for m in tpm2 tpm2+pin fido2 password recovery-key; do
		arg_method="$m"
		unenroll_device /dev/x
	done
	is "slots" "--wipe-slot=tpm2 /dev/x|--wipe-slot=tpm2 /dev/x|--wipe-slot=fido2 /dev/x|--wipe-slot=password /dev/x|--wipe-slot=recovery /dev/x" \
		"$(paste -sd '|' "$workdir/wipe")"
	arg_method=bogus
	says "unknown method" "$(strict unenroll_device /dev/x 2>&1)" "Methods present in /dev/x: password,tpm2"
	return 0
}

