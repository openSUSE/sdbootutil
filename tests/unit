# PCR 15: the measurement log and the report.  The digests are the
# ones measured on a guest: the volume key of its root, and the end of
# the initrd

VK="3dc9970202dc971eff4a39c3282e850e7218af84d60334b5937f988da8ddf0bb"
LEAVE="3be261aff7db92bf507eae947f4003ffa2bcad0bffe3524601d62d0bc8be7135"
# PCR 15 after the volume key, and after the end of the initrd too
PCR15_VK="47213c494b32c9f1f7905887bbb66101672b94fa628c225ecef188abd4a8d6b3"
PCR15_VK_LEAVE="af1580f2a8d43bc468264f3ae5e5bf2e46f2d2458f4e52533532525287b58dbf"
# PCR 15 after the end of the initrd only, no volume key measured
PCR15_LEAVE="4cc7f58e12f3393e31f32b547e15a980435e42c492f672f52adcea43cf4595a2"

# Empty scratch copies of the paths that the PCR 15 code uses
pcr15_setup()
{
	load
	local d
	for d in /var/lib/sdbootutil /var/lib/pcrlock.d /var/lib/systemd /run/log/systemd; do
		mkdir -p "$d"
		scratch_dir "$d"
	done
	[ -e /etc/crypttab ] || skip "/etc/crypttab is needed as a mount point"
	echo "root UUID=1 none x-initrd.attach,tpm2-device=auto,tpm2-measure-pcr=yes" > "$workdir/crypttab"
	mountpoint -q /etc/crypttab || mount --bind "$workdir/crypttab" /etc/crypttab
}

# A systemd measurement log (RFC 7464 JSON-seq) with one record per
# argument, "PCR:TYPE:DIGEST[:STRING]"
pcr15_log()
{
	local r pcr type digest string
	for r in "$@"; do
		IFS=: read -r pcr type digest string <<<"$r"
		printf '\036{"pcr":%s,"digests":[{"hashAlg":"sha256","digest":"%s"}],"content_type":"systemd","content":{"eventType":"%s","string":"%s"}}\n' \
		       "$pcr" "$digest" "$type" "$string"
	done > /run/log/systemd/tpm2-measure.log
}

t_p15_replay()
{
	load

	is "nothing" "" "$(pcr15_replay < /dev/null)"
	is "volume key" "$PCR15_VK" "$(echo "$VK" | pcr15_replay)"
	is "volume key, end of initrd" "$PCR15_VK_LEAVE" "$(printf '%s\n%s\n' "$VK" "$LEAVE" | pcr15_replay)"
	is "end of initrd only" "$PCR15_LEAVE" "$(echo "$LEAVE" | pcr15_replay)"
}

t_p15_events()
{
	pcr15_setup
	pcr15_log "15:volume-key:$VK" "11:phase:$LEAVE" "15:phase:$LEAVE" "15:machine-id:$PCR15_VK"

	is "volume keys" "$VK" "$(pcr15_events /run/log/systemd/tpm2-measure.log volume-key)"
	is "end of initrd" "$LEAVE" "$(pcr15_events /run/log/systemd/tpm2-measure.log phase)"
}

# The value of PCR 15 once the anchor is measured, from the log: only
# when the log explains the current PCR 15 (systemd-analyze, replaced
# here), and the record of the anchor comes before the end of the
# initrd
t_p15_bound()
{
	pcr15_setup
	local uuid pcr15_now
	uuid="$(cryptsetup luksUUID "$dev")"
	systemd-analyze() { echo "[{\"nr\":15,\"sha256\":\"$pcr15_now\"}]"; }

	pcr15_log "15:volume-key:$VK:cryptsetup:root:$uuid" "15:phase:$LEAVE:leave-initrd"
	pcr15_now="$PCR15_VK_LEAVE"
	is "in the initrd" "$PCR15_VK" "$(pcr15_bound_value "$dev" "")"
	is "after the initrd" "$PCR15_VK_LEAVE" "$(pcr15_bound_value "$dev" leave-initrd)"

	pcr15_now="$PCR15_VK"
	is "a log that does not explain PCR 15" "" "$(pcr15_bound_value "$dev" "")"

	pcr15_log "15:phase:$LEAVE:leave-initrd" "15:volume-key:$VK:cryptsetup:root:$uuid"
	pcr15_now="$(printf '%s\n%s\n' "$LEAVE" "$VK" | pcr15_replay)"
	is "measured after the initrd" "" "$(pcr15_bound_value "$dev" "")"

	pcr15_log "15:volume-key:$VK:cryptsetup:root:00000000-0000-0000-0000-000000000000"
	pcr15_now="$PCR15_VK"
	is "another device" "" "$(pcr15_bound_value "$dev" "")"
}

# The anchor is bound to zero, the other devices to PCR 15 after the
# anchor: in the initrd when its crypttab names them, after it if not
t_p15_slot_value()
{
	load
	local anchor=/dev/sdbootutil-unit-anchor
	pcr15_bound_value() { echo "phase=$2"; }
	# shellcheck disable=SC2034  # read by the sourced library
	initrd_crypttab_read=1

	is "anchor" "$(printf '%064d' 0)" "$(pcr15_slot_value "$anchor" "$anchor")"
	# shellcheck disable=SC2034  # read by the sourced library
	initrd_crypttab_cache="data $dev none x-initrd.attach,tpm2-device=auto"
	is "in the initrd" "phase=" "$(pcr15_slot_value "$dev" "$anchor")"
	# shellcheck disable=SC2034  # read by the sourced library
	initrd_crypttab_cache="other /dev/null none tpm2-device=auto"
	is "after the initrd" "phase=leave-initrd" "$(pcr15_slot_value "$dev" "$anchor")"
}

t_p15_binding()
{
	load
	local bound='"0":{"type":"systemd-tpm2","tpm2_pcrlock":true,"tpm2-pcrs":[15],"keyslots":["0"]}'
	local plain='"1":{"type":"systemd-tpm2","tpm2_pcrlock":true,"tpm2-pcrs":[],"keyslots":["1"]}'
	local pin='"2":{"type":"systemd-tpm2","tpm2_pcrlock":true,"tpm2-pin":true,"keyslots":["2"]}'
	local signed='"3":{"type":"systemd-tpm2","tpm2_pubkey":"x","keyslots":["3"]}'

	is "bound" "bound" "$(tpm2_slot_binding x "{\"tokens\":{$bound}}")"
	is "bound and plain" "bound+plain" "$(tpm2_slot_binding x "{\"tokens\":{$bound,$plain}}")"
	is "plain" "plain" "$(tpm2_slot_binding x "{\"tokens\":{$plain,$pin}}")"
	is "pin" "pin" "$(tpm2_slot_binding x "{\"tokens\":{$pin}}")"
	is "signed only" "none" "$(tpm2_slot_binding x "{\"tokens\":{$signed}}")"

	luks_header() { echo "{\"tokens\":{$bound,$plain,$pin,$signed}}"; }
	is "unbound keyslots" "1" "$(unbound_tpm2_keyslots x)"
}

# A pcrlock component with one sha256 digest
pcrlock_variation()
{
	printf '{"records":[{"pcr":5,"digests":[{"hashAlg":"sha256","digest":"%s"}]}]}\n' "$1"
}

# shift_component sets aside the variation of the current boot, and
# restore_shifts puts it back only when the new prediction differs
t_shift()
{
	pcr15_setup
	# shellcheck disable=SC2034  # read by the sourced library
	local tmpdir="$workdir/tmp" d=/var/lib/pcrlock.d/641-test.pcrlock.d
	mkdir -p "$tmpdir" "$d"
	# shellcheck disable=SC2034  # read by the sourced library
	declare -gA eventlog=(["$VK"]=1)

	pcrlock_variation "$VK" > "$d/generated.pcrlock"
	pcrlock_variation "$LEAVE" > "$d/old.pcrlock"
	shift_component 641-test
	is "variations removed" "" "$(ls "$d")"
	pcrlock_variation "$VK" > "$d/generated.pcrlock"
	restore_shifts
	is "unchanged: nothing kept" "generated.pcrlock" "$(ls "$d")"

	shift_component 641-test
	pcrlock_variation "$PCR15_VK" > "$d/generated.pcrlock"
	restore_shifts
	is "changed: the boot is kept" "generated.pcrlock shift-generated.pcrlock" "$(ls "$d" | tr '\n' ' ' | sed 's/ $//')"

	# The kept one still matches the next run, under its own name
	pcrlock_variation "$PCR15_VK" > "$d/generated.pcrlock"
	shift_component 641-test
	pcrlock_variation "$PCR15_VK" > "$d/generated.pcrlock"
	restore_shifts
	is "still changed" "generated.pcrlock shift-generated.pcrlock" "$(ls "$d" | tr '\n' ' ' | sed 's/ $//')"

	# Nothing matches the event log: the old variations go too, or
	# the ones of entries that are gone would stay in the policy
	rm -f "$d"/*
	pcrlock_variation "$LEAVE" > "$d/generated.pcrlock"
	shift_component 641-test
	is "no match" "" "$(ls "$d")"
}

# restore_shifts keeps the current boot in a full component by removing
# its last variation, so the PCR stays inside the PolicyOR limit
t_shift_limit()
{
	pcr15_setup
	# shellcheck disable=SC2034  # read by the sourced library
	local tmpdir="$workdir/tmp" c=710-kernel-cmdline-initrd-entry n
	local d="/var/lib/pcrlock.d/$c.pcrlock.d"
	mkdir -p "$tmpdir/shift/$c.pcrlock.d" "$d"

	for n in 1 2 3 4; do
		echo "$n" > "$d/cmdline-initrd-$n.pcrlock"
	done
	echo "boot" > "$tmpdir/shift/$c.pcrlock.d/shift-cmdline-initrd-1.pcrlock"
	restore_shifts
	is "full: the last goes" "cmdline-initrd-1.pcrlock cmdline-initrd-2.pcrlock cmdline-initrd-3.pcrlock shift-cmdline-initrd-1.pcrlock" "$(cd "$d" && echo *)"

	rm -f "$d"/*
	echo 1 > "$d/cmdline-initrd-1.pcrlock"
	mkdir -p "$tmpdir/shift/$c.pcrlock.d"
	echo "boot" > "$tmpdir/shift/$c.pcrlock.d/shift-cmdline-initrd-1.pcrlock"
	restore_shifts
	is "room: nothing goes" "cmdline-initrd-1.pcrlock shift-cmdline-initrd-1.pcrlock" "$(cd "$d" && echo *)"
	rm -rf "$d"

	# The number says the priority, not the name
	c=650-kernel-efi-application d="/var/lib/pcrlock.d/$c.pcrlock.d"
	mkdir -p "$tmpdir/shift/$c.pcrlock.d" "$d"
	for n in linux-1 uki-2 linux-3 linux-4; do
		echo "$n" > "$d/$n.pcrlock"
	done
	echo "boot" > "$tmpdir/shift/$c.pcrlock.d/shift-linux-1.pcrlock"
	restore_shifts
	is "kernels and UKIs: the last goes" "linux-1.pcrlock linux-3.pcrlock shift-linux-1.pcrlock uki-2.pcrlock" "$(cd "$d" && echo *)"
	rm -rf "$d"
}

# entries_bind_pcr15 needs every initrd to measure the anchor alone,
# order the rest after it, measure the end of the initrd, and unlock
# the same devices as the initrd of the default entry
# shellcheck disable=SC2329  # the stubs are called by the sourced library
t_entries_bind()
{
	load
	# shellcheck disable=SC2034  # read by the sourced library
	local tmpdir="$workdir/tmp" boot_root="$workdir/boot" entryfile="$workdir/entries.json"
	mkdir -p "$tmpdir" "$boot_root"
	touch "$boot_root/a" "$boot_root/b"
	local ct_default="root UUID=1 none x-initrd.attach,tpm2-device=auto,tpm2-measure-pcr=yes
swap UUID=2 none tpm2-device=auto"
	local ct_a="$ct_default" ct_b="$ct_default" generator='After=systemd-cryptsetup@$anchor.service' boundary=1

	initrd_crypttab() { echo "$ct_default"; }
	update_entries_for_this_system() { echo '[{"type":"type1","initrd":["/a"]},{"type":"type1","initrd":["/b"]}]' > "$entryfile"; }
	# shellcheck disable=SC2329  # called by the sourced library
	lsinitrd()
	{
		local ct="$ct_a"
		[ "${2##*/}" = a ] || ct="$ct_b"
		mkdir -p etc usr/lib/systemd/system-generators usr/lib/systemd/system
		echo "$ct" > etc/crypttab
		echo "$generator" > usr/lib/systemd/system-generators/measure-pcr-generator
		[ -z "$boundary" ] || touch usr/lib/systemd/system/measure-pcr-boundary.service
	}

	entries_bind_pcr15 root || fail "every initrd binds PCR 15, but it was refused"
	ct_b="${ct_default%%$'\n'*}"
	entries_bind_pcr15 root && fail "an initrd that does not unlock the swap was accepted"
	ct_b="$ct_default"
	ct_a="${ct_default/tpm2-device=auto$/tpm2-device=auto,tpm2-measure-pcr=yes}"
	ct_a="${ct_a%swap*}swap UUID=2 none tpm2-device=auto,tpm2-measure-pcr=yes"
	entries_bind_pcr15 root && fail "an initrd that measures another device was accepted"
	ct_a="${ct_default/,tpm2-measure-pcr=yes/}"
	entries_bind_pcr15 root && fail "an initrd where the anchor does not measure was accepted"
	ct_a="$ct_default"
	generator="# the anchor is mentioned only in a comment"
	entries_bind_pcr15 root && fail "a generator without the anchor ordering was accepted"
	generator='After=systemd-cryptsetup@$anchor.service' boundary=
	entries_bind_pcr15 root && fail "an initrd without the boundary was accepted"

	# A UKI of the packages: no crypttab in its initrd, the one of
	# its addon counts
	boundary=1 ct_a=""
	touch "$boot_root/u.efi"
	update_entries_for_this_system() { echo '[{"type":"type1","uki":"/u.efi","addons":[{"localAddon":"/c.addon.efi"}]}]' > "$entryfile"; }
	addons_crypttab() { [ "$*" != /c.addon.efi ] || echo "$ct_default"; }
	lsinitrd()
	{
		mkdir -p usr/lib/systemd/system-generators usr/lib/systemd/system
		[ -z "$ct_a" ] || { mkdir -p etc; echo "$ct_a" > etc/crypttab; }
		echo "$generator" > usr/lib/systemd/system-generators/measure-pcr-generator
		touch usr/lib/systemd/system/measure-pcr-boundary.service
	}
	entries_bind_pcr15 root || fail "the crypttab of the addon was not read"
	addons_crypttab() { :; }
	entries_bind_pcr15 root && fail "a UKI without a crypttab was accepted"
	return 0
}

# addons_crypttab reads the crypttab in the initrd of the addons, and
# skips the addons without one
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_addons_crypttab()
{
	command -v cpio > /dev/null || skip "cpio is not installed"
	load
	local boot_root="$workdir/esp" tmpdir="$workdir/tmp"
	mkdir -p "$boot_root" "$tmpdir"
	dracut_crypttab() { echo "cr_root UUID=1111 none x-initrd.attach,tpm2-measure-pcr=yes"; }
	crypttab_cpio "$boot_root/c.addon.efi.initrd"
	objcopy() { if [ -e "$4.initrd" ]; then cp "$4.initrd" "$5"; else : > "$5"; fi; }
	is "crypttab" "cr_root UUID=1111 none x-initrd.attach,tpm2-measure-pcr=yes" "$(addons_crypttab /r.addon.efi /c.addon.efi)"
	is "none" "" "$(addons_crypttab /r.addon.efi)"
	return 0
}

t_p15_status()
{
	pcr15_setup
	# shellcheck disable=SC2034  # read by the sourced library
	declare -gA eventlog=(["none"]=1)
	local out

	out="$(status_pcr15)"
	says "enabled" "$out" "Enabled:         yes"
	says "no log" "$out" "cannot be told"

	pcr15_log "15:volume-key:$VK" "15:phase:$LEAVE"
	out="$(status_pcr15)"
	says "this boot" "$out" "the volume key of the anchor was measured"
	says "end of initrd" "$out" "End of initrd:   measured"

	pcr15_log "15:volume-key:$VK"
	out="$(status_pcr15)"
	says "no boundary" "$out" "NOT measured in this boot"

	pcr15_log "11:phase:$LEAVE"
	out="$(status_pcr15)"
	says "nothing measured" "$out" "NOTHING was measured"
}

# UKI from /etc/sysconfig/bootloader: empty, "no", "yes" or "local".
# The last two need systemd-boot, and grub2-bls falls back to the
# kernel and the initrd
# shellcheck disable=SC2034  # UKI is read by the sourced library
t_uki_config()
{
	load
	local loader=systemd-boot
	# shellcheck disable=SC2329  # called by the sourced library
	bootloader_type() { echo "$loader"; }

	local UKI value
	# shellcheck disable=SC2329  # called by the sourced library
	is_shim_installed() { return 1; }
	# The tools of UKI="local", as empty scripts
	local tool systemd_sbsign="$workdir/bin/systemd-sbsign"
	mkdir -p "$workdir/bin"
	for tool in openssl systemd-creds objcopy objdump systemd-sbsign; do
		echo '#!/bin/sh' > "$workdir/bin/$tool"
		chmod +x "$workdir/bin/$tool"
	done
	local PATH="$workdir/bin:$PATH"
	for value in "" no yes local; do
		UKI="$value"
		( assert_uki_config ) > /dev/null 2>&1 || fail "UKI=\"$value\" was refused"
	done
	# A missing tool of UKI="local"
	UKI=local
	# shellcheck disable=SC2123  # no tool can be found
	( PATH=/nonexistent; assert_uki_config ) > /dev/null 2>&1 && fail "UKI=local without its tools was accepted"
	UKI=distribution
	( assert_uki_config ) > /dev/null 2>&1 && fail "UKI=\"distribution\" was accepted"
	# grub2-bls boots the kernel and the initrd, with a warning
	loader=grub2-bls
	for value in yes local; do
		UKI="$value"
		says "$value with grub2-bls" "$( (assert_uki_config) 2>&1)" "needs systemd-boot, using the kernel and the initrd"
		assert_uki_config 2> /dev/null || fail "UKI=\"$value\" with grub2-bls failed"
		is "$value with grub2-bls: no UKI" "" "$UKI"
	done
	UKI=no
	( assert_uki_config ) > /dev/null 2>&1 || fail "UKI=\"no\" with grub2-bls was refused"
	return 0
}

# uki_mode_text and uki_missing_kernels: the UKI row of "status", and
# the kernels that have no UKI file with UKI="yes"
# shellcheck disable=SC2034  # UKI is read by the sourced library
t_uki_status()
{
	load
	local UKI modules="$workdir/modules" version=7.3.4-1-default
	mkdir -p "$modules/$version"
	touch "$modules/$version/vmlinuz"

	UKI=""
	says "no" "$(uki_mode_text)" "no, kernel and initrd"
	UKI=local
	says "local" "$(uki_mode_text)" "local"
	is "local needs no file" "" "$(uki_missing_kernels "$modules")"

	UKI=yes
	says "yes" "$(uki_mode_text)" "distribution"
	# vmlinuz.efi (arm64 zboot) is a kernel, not a UKI
	touch "$modules/$version/vmlinuz.efi"
	is "missing" "$version" "$(uki_missing_kernels "$modules")"
	touch "$modules/$version/vmlinuz-generic.efi"
	is "present" "" "$(uki_missing_kernels "$modules")"
	return 0
}

# uki_keys makes the keys of UKI="local" when they are missing, stores
# the private parts only encrypted, and uki_key gives them back
# shellcheck disable=SC2034  # read by the sourced library
t_uki_keys()
{
	command -v openssl > /dev/null || skip "openssl is not installed"
	systemd-creds has-tpm2 &> /dev/null || skip "no TPM2 for systemd-creds"
	load
	local UKI=local credstore="$workdir/credstore"
	local secureboot_certificate="$workdir/kernel/secureboot-certificate.pem"
	local pcr_public_key="$workdir/systemd/tpm2-pcr-initrd-public-key.pem"
	local text

	uki_keys > /dev/null 2>&1 || fail "uki_keys failed"
	text="$(openssl x509 -in "$secureboot_certificate" -noout -text 2> /dev/null)"
	says "code signing" "$text" "Code Signing"
	says "RSA 4096" "$text" "4096 bit"
	grep -qs "PRIVATE KEY" "$credstore/secureboot-private-key.pem" && fail "the key is stored in clear"
	private_key secureboot-private-key.pem 2> /dev/null | openssl pkey -noout 2> /dev/null || fail "the key does not decrypt"

	if grep -qs "tpm2-device" /etc/crypttab; then
		[ -s "$pcr_public_key" ] || fail "no PCR public key"
		private_key tpm2-pcr-initrd-private-key.pem 2> /dev/null | openssl pkey -noout 2> /dev/null || fail "the PCR key does not decrypt"
	fi

	# Made once, never replaced
	local before
	before="$(cat "$secureboot_certificate")"
	uki_keys > /dev/null 2>&1
	is "kept" "$before" "$(cat "$secureboot_certificate")"

	# A missing certificate is made again, for the same key
	rm "$secureboot_certificate"
	uki_keys > /dev/null 2>&1
	is "certificate of the key" "$(private_key secureboot-private-key.pem 2> /dev/null | openssl pkey -pubout 2> /dev/null)" \
		"$(openssl x509 -in "$secureboot_certificate" -noout -pubkey 2> /dev/null)"
	return 0
}

# mok_enroll imports a missing certificate once, waits while it is
# pending, and imports it again when a boot did not enroll it
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_mok()
{
	command -v openssl > /dev/null || skip "openssl is not installed"
	load
	local tmpdir="$workdir/tmp" state=missing imports=0
	local secureboot_certificate="$workdir/sb.pem"
	mkdir -p "$tmpdir" /var/lib/sdbootutil
	openssl req -new -x509 -nodes -newkey rsa:2048 -keyout /dev/null -subj /CN=test \
		-out "$secureboot_certificate" 2> /dev/null
	local shadow=""
	is_secure_boot() { return 0; }
	is_shim_installed() { return 0; }
	getent() { echo "root:$shadow:20000::::::"; }
	mokutil()
	{
		case "$1" in
			--test-key)
				case "$state" in
					enrolled) echo "x is already enrolled" ;;
					pending) echo "x is already in the enrollment request" ;;
					*) echo "x is not enrolled" ;;
				esac ;;
			--generate-hash=*) echo "hash" ;;
			--import) imports=$((imports + 1)); state=pending; echo "$*" > "$workdir/import" ;;
		esac
	}
	rm -f /var/lib/sdbootutil/mok-import

	# root without a password: a one-time password
	mok_enroll > "$workdir/out" 2>&1
	says "password" "$(cat "$workdir/out")" "MOK password: "
	says "hash file" "$(cat "$workdir/import")" "--hash-file"
	is "pending" "pending" "$(mok_state)"
	mok_enroll > /dev/null 2>&1
	is "imported once" "1" "$imports"

	# A boot that did not enroll it, and root has a password now
	# shellcheck disable=SC2016  # a literal hash
	state=missing shadow='$6$salt$hash'
	mok_enroll > "$workdir/out" 2>&1
	says "retry" "$(cat "$workdir/out")" "not enrolled in MOK at the last boot"
	says "root password" "$(cat "$workdir/import")" "--root-pw"
	grep -q "MOK password" "$workdir/out" && fail "a password was printed with --root-pw"
	is "imported again" "2" "$imports"

	state=enrolled
	mok_enroll > /dev/null 2>&1
	[ ! -e /var/lib/sdbootutil/mok-import ] || fail "the marker stays after the enrollment"
	return 0
}

# build_addon makes a signed addon with the exact command line, and the
# initrd when given, and pe_add_sections puts each section after the
# last one
# shellcheck disable=SC2034  # read by the sourced library
t_addon()
{
	local tool
	for tool in openssl objcopy objdump /usr/lib/systemd/systemd-sbsign; do
		command -v "$tool" > /dev/null || skip "$tool is not installed"
	done
	[ -e /usr/lib/systemd/boot/efi/addonx64.efi.stub ] || skip "no addon stub"
	load
	local tmpdir="$workdir/tmp" firmware_arch=x64 addon="$workdir/test.addon.efi"
	local secureboot_certificate="$workdir/sb.pem"
	mkdir -p "$tmpdir"
	openssl req -new -x509 -nodes -newkey rsa:2048 -keyout "$workdir/sb.key" -subj /CN=test \
		-out "$secureboot_certificate" 2> /dev/null
	# shellcheck disable=SC2329  # called by the sourced library
	private_key() { cat "$workdir/sb.key"; }

	build_addon "rootflags=subvol=@/.snapshots/42/snapshot" "$addon" || fail "build_addon failed"
	# Signed again, the same file: the measurement does not change
	sleep 1
	build_addon "rootflags=subvol=@/.snapshots/42/snapshot" "$workdir/again.addon.efi" || fail "build_addon failed"
	cmp -s "$addon" "$workdir/again.addon.efi" || fail "the same addon signed again is another file"
	is "command line" "rootflags=subvol=@/.snapshots/42/snapshot" \
	   "$(pe_section_text "$addon" .cmdline)"
	says "sbat" "$(pe_section_text "$addon" .sbat)" "uki-addon,1"
	says "signed" "$(objdump -p "$addon")" "Security Directory"
	is "size of .cmdline" "00000029" "$(objdump -h "$addon" | awk '$2 == ".cmdline" {print $3}')"
	is "aligned" "000" "$(objdump -h "$addon" | awk '$2 == ".sbat" {print substr($4, length($4) - 2)}')"
	objdump -h "$addon" | grep -q '\.initrd' && fail "an initrd that was not asked for"

	# With an initrd
	head -c 1000 /dev/urandom > "$workdir/addon-initrd"
	build_addon "root=/dev/mapper/cr_root" "$addon" "$workdir/addon-initrd" || fail "build_addon with an initrd failed"
	objcopy -O binary --only-section=.initrd "$addon" "$workdir/section"
	cmp -s "$workdir/section" "$workdir/addon-initrd" || fail "the initrd is not the one given"
	is "command line with an initrd" "root=/dev/mapper/cr_root" "$(pe_section_text "$addon" .cmdline)"
	return 0
}

# build_uki makes a signed UKI, and with the PCR key its .pcrsig is
# the signature of the exact sections that it carries
# shellcheck disable=SC2034  # read by the sourced library
t_uki()
{
	local tool
	for tool in openssl objcopy objdump /usr/lib/systemd/systemd-sbsign /usr/lib/systemd/systemd-measure; do
		command -v "$tool" > /dev/null || skip "$tool is not installed"
	done
	[ -e /usr/lib/systemd/boot/efi/linuxx64.efi.stub ] || skip "no UKI stub"
	load
	local tmpdir="$workdir/tmp" firmware_arch=x64 uki="$workdir/test.efi" x="$workdir/x" sec
	local secureboot_certificate="$workdir/sb.pem" pcr_public_key="$workdir/pcr.pem" credstore="$workdir/cred"
	mkdir -p "$tmpdir" "$x" "$credstore"
	openssl req -new -x509 -nodes -newkey rsa:2048 -keyout "$workdir/sb.key" -subj /CN=test \
		-out "$secureboot_certificate" 2> /dev/null
	openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$workdir/pcr.key" 2> /dev/null
	openssl pkey -in "$workdir/pcr.key" -pubout -out "$pcr_public_key"
	touch "$credstore/tpm2-pcr-initrd-private-key.pem"
	# shellcheck disable=SC2329  # called by the sourced library
	private_key()
	{
		case "$1" in
			secureboot-private-key.pem) cat "$workdir/sb.key" ;;
			*) cat "$workdir/pcr.key" ;;
		esac
	}
	head -c 4096 /dev/urandom > "$workdir/linux"
	head -c 4096 /dev/urandom > "$workdir/initrd"

	build_uki "$workdir/linux" "$workdir/initrd" "root=UUID=1 quiet" /usr/lib/os-release 7.3.4-1-default "$uki" || \
		fail "build_uki failed"
	is "command line" "root=UUID=1 quiet" "$(pe_section_text "$uki" .cmdline)"
	is "uname" "7.3.4-1-default" "$(pe_section_text "$uki" .uname)"
	says "signed" "$(objdump -p "$uki")" "Security Directory"

	for sec in linux initrd cmdline osrel uname sbat pcrpkey pcrsig; do
		objcopy -O binary --only-section=".$sec" "$uki" "$x/$sec"
	done
	cmp -s "$x/linux" "$workdir/linux" || fail "the kernel changed"
	/usr/lib/systemd/systemd-measure sign --linux="$x/linux" --initrd="$x/initrd" --cmdline="$x/cmdline" \
		--osrel="$x/osrel" --uname="$x/uname" --sbat="$x/sbat" --pcrpkey="$x/pcrpkey" \
		--bank=sha256 --phase=enter-initrd --policyref=initrd \
		--private-key="$workdir/pcr.key" --public-key="$pcr_public_key" --json=short > "$x/resign" 2> /dev/null
	is "signature of the sections" "$(jq -c . "$x/resign")" "$(jq -c . "$x/pcrsig")"

	# A new snapshot reuses the UKI of its parent, and an entry its own
	# UKI, only with the same command line and the same kernel
	local boot_root="$workdir/esp" entry_token=t
	mkdir -p "$boot_root/t" "$boot_root/loader/entries"
	cp "$uki" "$boot_root/t/uki.efi"
	echo "uki /t/uki.efi" > "$boot_root/loader/entries/t-commit_5.5.7.3.4-1-default.conf"
	# shellcheck disable=SC2034,SC2329  # read by the sourced library
	detect_parent() { parent_snapshot=5; }
	is "reused" "$boot_root/loader/entries/t-commit_5.5.7.3.4-1-default.conf" \
		"$(reusable_uki 6 @/.snapshots/6/snapshot 7.3.4-1-default "root=UUID=1 quiet" "$workdir/linux")"
	reusable_uki 6 @/.snapshots/6/snapshot 7.3.4-1-default "root=UUID=2 quiet" "$workdir/linux" && \
		fail "reused with another command line"
	head -c 4096 /dev/urandom > "$workdir/linux2"
	reusable_uki 6 @/.snapshots/6/snapshot 7.3.4-1-default "root=UUID=1 quiet" "$workdir/linux2" && \
		fail "reused with another kernel"
	detect_parent() { parent_snapshot=""; }
	is "its own" "$boot_root/loader/entries/t-commit_5.5.7.3.4-1-default.conf" \
		"$(reusable_uki 5 @/.snapshots/5/snapshot 7.3.4-1-default "root=UUID=1 quiet" "$workdir/linux")"
	return 0
}

# The addon of an entry is built again for another command line or a
# new signing key: the name in the ESP decides if it is there already
# shellcheck disable=SC2034  # read by the sourced library
t_addon_name()
{
	load
	local secureboot_certificate="$workdir/cert.pem" a b
	echo "key 1" > "$secureboot_certificate"
	a="$(addon_name "rootflags=subvol=@/.snapshots/5/snapshot")"
	is "same" "$a" "$(addon_name "rootflags=subvol=@/.snapshots/5/snapshot")"
	[ "$a" != "$(addon_name "rootflags=subvol=@/.snapshots/6/snapshot")" ] || fail "the same name for another command line"
	echo "key 2" > "$secureboot_certificate"
	b="$(addon_name "rootflags=subvol=@/.snapshots/5/snapshot")"
	[ "$a" != "$b" ] || fail "the same name for another key"
	[[ "$b" == cmdline-*.addon.efi ]] || fail "unexpected name $b"
	return 0
}

# link_uki links the addon of the snapshot, never one with an initrd:
# the crypttab is in the addon of the root, that is not linked
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_link_uki_addon()
{
	load
	local boot_root="$workdir/esp" entry_token=t tmpdir="$workdir/tmp" secureboot_certificate="$workdir/cert.pem"
	local UKI=yes arg_force=''
	mkdir -p "$boot_root/t" "$boot_root/loader/entries" "$tmpdir"
	echo "key" > "$secureboot_certificate"
	touch "$workdir/uki.efi"
	entry_title_and_sort_key() { local -n t_t="$1" t_s="$2"; t_t=T; t_s=s; }
	uki_addon_cmdline() { echo "rootflags=subvol=@/.snapshots/5/snapshot"; }
	build_addon() { echo "addon[$1]${3:+ with an initrd}" >> "$workdir/link-addons"; touch "$2"; }
	make_free_space() { :; }
	record_esp_file() { :; }
	unlink_replaced_entry() { :; }
	bootctl_entries() { :; }
	bootctl() { echo "$*" > "$workdir/link-args"; echo "sort-key x" > "$boot_root/loader/entries/t-commit_5.5.7.3.5-1-default.conf"; }
	link_uki 5 @/.snapshots/5/snapshot 7.3.5-1-default "$workdir/uki.efi" "" "" > /dev/null 2>&1
	is "addon" "addon[rootflags=subvol=@/.snapshots/5/snapshot]" "$(cat "$workdir/link-addons")"
	says "linked" "$(cat "$workdir/link-args")" "--extra=$tmpdir/cmdline-"
	return 0
}

# The addon of the root has "root=" and the crypttab when the discovery
# does not find the root.  It is written again only when it changes:
# a new disk, or a new key.  It goes away with the discovery, or
# without UKIs
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_update_dps_addon()
{
	load
	local boot_root="$workdir/esp" entry_token=t tmpdir="$workdir/tmp" UKI=yes t_problem="not DPS" t_ct="cr_root" t_key=key1
	local out="$workdir/esp/loader/addons/t-dps.addon.efi"
	mkdir -p "$boot_root" "$tmpdir"
	uki_keys() { :; }
	dps_root_problem() { echo "$t_problem"; }
	get_rootfs() { echo /dev/mapper/cr_root; }
	crypttab_cpio() { echo "$t_ct" > "$1"; }
	# The addon is the command line, the initrd and the key
	build_addon() { { echo "$1"; cat "$3"; echo "$t_key"; } > "$2"; }
	record_esp_file() { echo written >> "$workdir/dps-written"; }

	dps_addon_done='' update_dps_addon > /dev/null 2>&1
	is "made" "$(printf 'root=/dev/mapper/cr_root\ncr_root\nkey1')" "$(cat "$out" 2> /dev/null)"
	dps_addon_done='' update_dps_addon > /dev/null 2>&1
	is "not written again" 1 "$(wc -l < "$workdir/dps-written")"
	t_ct="cr_root cr_new"
	dps_addon_done='' update_dps_addon > /dev/null 2>&1
	is "a new disk" "$(printf 'root=/dev/mapper/cr_root\ncr_root cr_new\nkey1')" "$(cat "$out" 2> /dev/null)"
	t_key=key2
	dps_addon_done='' update_dps_addon > /dev/null 2>&1
	is "a new key" "$(printf 'root=/dev/mapper/cr_root\ncr_root cr_new\nkey2')" "$(cat "$out" 2> /dev/null)"
	t_problem=""
	dps_addon_done='' update_dps_addon > /dev/null 2>&1
	[ -e "$out" ] && fail "the addon stays with DPS"
	t_problem="not DPS"
	dps_addon_done='' update_dps_addon > /dev/null 2>&1
	UKI=""
	dps_addon_done='' update_dps_addon > /dev/null 2>&1
	[ -e "$out" ] && fail "the addon stays without UKIs"
	return 0
}

# The UKIs in the ESP that the addon of the root reaches and that are
# not of this system: /EFI/Linux, and other entry tokens
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_dps_addon_others()
{
	load
	local entry_token=t
	bootctl_entries()
	{
		echo '[{"type": "type1", "id": "t-commit_5.5.7.3.5-1-default.conf", "uki": "/t/u.efi"},
