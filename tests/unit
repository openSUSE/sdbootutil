# reuse_initrd takes the initrd of the parent, and leaves the entry
# token of the snapshot: the new entry is written with it
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_reuse_initrd_token()
{
	load
	local boot_root="$workdir/esp" entry_token arg_no_reuse_initrd="" dstinitrd=() reused_entry=
	mkdir -p "$boot_root/t"
	touch "$boot_root/t/initrd-1"
	echo "initrd /t/initrd-1" > "$workdir/parent.conf"
	settle_entry_token() { entry_token="token-of-$1"; }
	find_conf_file() { [ "$2" = 5 ] && echo "$workdir/parent.conf"; }
	detect_parent() { parent_subvol=@/.snapshots/5/snapshot parent_snapshot=5; }
	entry_token=token-of-6
	reuse_initrd 6 @/.snapshots/6/snapshot 7.3.5-1-default || fail "the initrd of the parent is not reused"
	is "initrd" "/t/initrd-1" "${dstinitrd[*]}"
	is "entry token" "token-of-6" "$entry_token"

	# An entry with a missing initrd is not reused
	printf 'initrd /t/initrd-1\ninitrd /t/initrd-gone\n' > "$workdir/parent.conf"
	dstinitrd=()
	reuse_initrd 6 @/.snapshots/6/snapshot 7.3.5-1-default 2> /dev/null && fail "an entry with a missing initrd is reused"
	is "no initrd" "" "${dstinitrd[*]}"
	return 0
}

# stage_initrd stages the initrd of the package for every kernel, also
# when the one of the previous kernel is still there
# shellcheck disable=SC2034  # read by the sourced library
t_stage_initrd_twice()
{
