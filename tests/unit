# update_entries_for_snapshot without a snapshot gives the entries of
# this system, and with one only those of the snapshot
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_update_entries_for_snapshot()
{
	load
	local entryfile="$workdir/entries.json" entry_token=t subvol_prefix=@ all_rootfs_cache=/dev/mapper/root
	bootctl_entries()
	{
		jq -n '[{id: "t-6.2.1-1-default-5.conf", options: "root=/dev/mapper/root rootflags=subvol=@/.snapshots/5/snapshot"},
			{id: "t-commit_7.7.6.2.1-1-default.conf", type: "type1", uki: "/t/a.efi"},
			{id: "t-commit_7.7.6.1.0-1-default.conf", type: "loader"},
			{id: "other-6.2.1-1-default-5.conf", options: "root=/dev/sdz1 rootflags=subvol=@/.snapshots/5/snapshot"},
			{id: "t-6.2.1-1-default-6.conf", options: "quiet rootflags=subvol=@/.snapshots/6/snapshot root=/dev/mapper/root"},
			{id: "t-6.2.1-1-default-60.conf", options: "root=/dev/mapper/root rootflags=subvol=@/.snapshots/60/snapshot"}]'
	}
	update_entries_for_snapshot ""
	is "this system" "t-6.2.1-1-default-5.conf t-commit_7.7.6.2.1-1-default.conf t-6.2.1-1-default-6.conf t-6.2.1-1-default-60.conf" "$(jq -r '[.[].id] | join(" ")' "$entryfile")"
	update_entries_for_snapshot 7
	is "snapshot 7" "t-commit_7.7.6.2.1-1-default.conf" "$(jq -r '[.[].id] | join(" ")' "$entryfile")"
	update_entries_for_snapshot 6
	is "rootflags first, not snapshot 60" "t-6.2.1-1-default-6.conf" "$(jq -r '[.[].id] | join(" ")' "$entryfile")"
	update_entries
	is "all, the filter does not stay" 6 "$(jq length "$entryfile")"
	return 0
}

