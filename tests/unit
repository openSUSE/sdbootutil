# get_final_pcrs reports the PCRs that cannot be predicted, and the
# reason, and prints the ones of the policy
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_get_final_pcrs()
{
	load
	local tmpfile="$workdir/tmpfile" out
	: > "$tmpfile"
	mask_unmatched_components() { false; }
	predict_pcrs() { echo '{"sha256": [{"pcr": 4, "values": ["a", "b"]}, {"pcr": 7, "values": ["1","2","3","4","5","6","7","8","9"]}]}'; }
	out="$(get_final_pcrs 4,7,9 2> "$workdir/err")"
	is "policy" "4" "$out"
	says "missing" "$(cat "$workdir/err")" "PCRs 9 dropped from the policy (component mapping)"
	says "policyor" "$(cat "$workdir/err")" "PCRs 7 dropped from the policy (PolicyOR)"
	predict_pcrs() { echo '{}'; }
	get_final_pcrs 4,7 > /dev/null 2>&1 && fail "an empty prediction is accepted"
	# "--pcr=" is the default list of systemd-pcrlock
	predict_pcrs() { echo '{"sha256": [{"pcr": 4, "values": ["a"]}]}'; }
	get_final_pcrs "" > /dev/null 2>&1 && fail "an empty list is accepted"
	predict_pcrs() { echo '{"sha256": [{"pcr": 7, "values": ["1","2","3","4","5","6","7","8","9"]}]}'; }
	get_final_pcrs 7 > /dev/null 2>&1 && fail "a policy without PCRs is accepted"
	return 0
}

# pcrlock_cmdline_initrd measures the command line once, for PCR 9 with
# the initrd, and for the boot loader in PCR 12, as UTF-16 with a NUL
# shellcheck disable=SC2034  # read by the sourced library
t_pcrlock_cmdline_initrd()
{
	command -v systemd-pcrlock > /dev/null || [ -x /usr/lib/systemd/systemd-pcrlock ] || skip "systemd-pcrlock is not installed"
	load
	local tmpdir="$workdir/tmp" pcrlock_cache="$workdir/cache" cmdline='initrd=\cfe\initrd-1 root=UUID=1 quiet' sum
	mkdir -p "$tmpdir"
	scratch_dir /var/lib/pcrlock.d
	head -c 4096 /dev/urandom > "$workdir/initrd"
	pcrlock_cmdline_initrd "$cmdline" "$workdir/initrd" 1
	read -r sum _ < <(echo -ne "${cmdline//\\/\\\\}\x00" | iconv -t UTF-16LE | sha256sum)
	is "PCR 12" "12 $sum" "$(jq -r '.records[] | "\(.pcr) \(.digests[] | select(.hashAlg == "sha256") | .digest)"' \
		/var/lib/pcrlock.d/710-kernel-cmdline-boot-loader.pcrlock.d/cmdline-1.pcrlock)"
	is "PCR 9" "9 $sum|9" "$(jq -r '[.records[] | "\(.pcr) \(.digests[] | select(.hashAlg == "sha256") | .digest)"] | .[0] + "|" + (.[1] | split(" ")[0])' \
		/var/lib/pcrlock.d/710-kernel-cmdline-initrd-entry.pcrlock.d/cmdline-initrd-1.pcrlock)"
	return 0
}

# settle_uki_mode: the TPM2 slots decide the UKI mode in effect.  A
# slot of pcr-oracle (signed policy, no pcrlock) is not a UKI slot
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_settle_uki_mode()
{
	pcr15_setup
	local UKI uki_config credstore="$workdir/settle-cred" header
	rm -rf "$credstore"
	mkdir -p "$credstore"
	detect_tracked_devices() { tracked_devices=(/dev/a); }
	luks_header() { echo "$header"; }
	header='{"tokens": {"0": {"type": "systemd-tpm2", "tpm2_pubkey": "k"}}}'
	UKI=local; settle_uki_mode
	is "pcr-oracle slot" "local" "$UKI"
	header='{"tokens": {"0": {"type": "systemd-tpm2", "tpm2_pcrlock": true}}}'
	UKI=local; settle_uki_mode
	is "plain slot" "" "$UKI"
	is "configuration" "local" "$uki_config"
	header='{"tokens": {"0": {"type": "systemd-tpm2", "tpm2_pcrlock": true, "tpm2_pubkey": "k"}}}'
	UKI=""; settle_uki_mode
	is "UKI slot" "yes" "$UKI"
	touch "$credstore/tpm2-pcr-initrd-private-key.pem"
	UKI=""; settle_uki_mode
	is "UKI slot with the local key" "local" "$UKI"
	return 0
}

# rebind_tpm2_slots makes the slot that enroll would make: with the UKIs
# the signed PCR 11 for a device of the initrd, and nothing for a device
# unlocked later; without them, PCR 15 for both
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_rebind_uki()
{
	pcr15_setup
	local UKI
	touch /var/lib/systemd/pcrlock.json
	detect_tracked_devices() { tracked_devices=(/dev/a /dev/b /dev/c); }
	measure_anchor() { echo /dev/a; }
	crypttab_field() { [ "$2" = name ] && echo root || { [ "$1" = /dev/a ] && echo "tpm2-measure-pcr=yes"; } || echo "tpm2-device=auto"; }
	tpm2_slot_binding() { [ "$1" = /dev/a ] && echo bound || echo plain; }
	read_initrd_crypttab() { :; }
	in_initrd_crypttab() { [ "$1" = /dev/b ]; }
	pcr15_slot_value() { echo "v-$1"; }
	uki_pcr_public_key() { echo /key; }
	entries_bind_pcr15() { return 1; }
	systemd-cryptenroll() { echo "$*" >> "$workdir/enroll"; }

	UKI=local; : > "$workdir/enroll"
	rebind_tpm2_slots
	is "UKI" "--tpm2-device=auto --tpm2-public-key=/key --tpm2-public-key-pcrs=11 --tpm2-public-key-policyref=initrd --tpm2-pcrlock=/var/lib/systemd/pcrlock.json --tpm2-pcrs=15:sha256=v-/dev/b --unlock-tpm2-device=auto /dev/b" \
		"$(cat "$workdir/enroll")"

	UKI=""; : > "$workdir/enroll"
	rebind_tpm2_slots
	is "kernel and initrd" "/dev/b /dev/c" "$(sed 's/.* //' "$workdir/enroll" | paste -sd ' ')"
	says "no signed policy" "$(cat "$workdir/enroll")" "--tpm2-public-key= --tpm2-pcrlock"
	return 0
}

# enroll_secret takes the secret of the method from its sources
# shellcheck disable=SC2034  # read by the sourced library
t_enroll_secret()
{
	PW=pw-env PIN=pin-env load
	local secret arg_method
	arg_method=password; secret=; enroll_secret secret
	is "password" "pw-env" "$secret"
	arg_method=tpm2+pin; secret=; enroll_secret secret
	is "TPM2 PIN" "pin-env" "$secret"
	arg_method=fido2; secret=; enroll_secret secret
