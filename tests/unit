# dracut_crypttab keeps the lines of /etc/crypttab that dracut puts in a
# host-only initrd: "x-initrd.attach" or "force", or a device that
# `dracut --print-cmdline` names (root, resume)
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_dracut_crypttab()
{
	load
	[ -e /etc/crypttab ] || skip "/etc/crypttab is needed as a mount point"
	local luks_uuid
	luks_uuid="$(cryptsetup luksUUID "$dev")"
	cat > "$workdir/crypttab" <<-EOF
	# a comment
	cr_swap $dev none tpm2-device=auto
	cr_root UUID=1111 none x-initrd.attach,tpm2-device=auto
	cr_force UUID=2222 none force
	cr_late UUID=3333 none tpm2-device=auto

	cr_byuuid UUID=$luks_uuid none
	cr_bylabel LABEL=data none
	cr_otherlabel LABEL=other none
	EOF
	mountpoint -q /etc/crypttab || mount --bind "$workdir/crypttab" /etc/crypttab
	dracut() { echo "rd.driver.pre=btrfs rd.luks.uuid=luks-$luks_uuid root=UUID=4444"; }
	# Not $dev in the stub: `device_path` has a local of that name
	local t_loop="$dev"
	blkid() { [ "${*: -1}" != LABEL=data ] || echo "$t_loop"; }
	is "lines" "cr_swap $dev none tpm2-device=auto|cr_root UUID=1111 none x-initrd.attach,tpm2-device=auto|cr_force UUID=2222 none force|cr_byuuid UUID=$luks_uuid none|cr_bylabel LABEL=data none" \
		"$(dracut_crypttab | paste -sd '|')"

	# dracut is asked only for a line without "x-initrd.attach" or
	# "force"
	echo "cr_root UUID=1111 none x-initrd.attach" > "$workdir/crypttab"
	dracut() { echo asked >> "$workdir/dracut-asked"; }
	is "only initrd lines" "cr_root UUID=1111 none x-initrd.attach" "$(dracut_crypttab)"
	[ ! -e "$workdir/dracut-asked" ] || fail "dracut was asked"

	# Without /etc/crypttab there is nothing to copy
	umount /etc/crypttab
	mount -t tmpfs none /etc
	local strict_vars="verbose"
	strict dracut_crypttab > "$workdir/no-crypttab" || fail "a missing /etc/crypttab ends the script"
	umount /etc
	is "no crypttab" "" "$(< "$workdir/no-crypttab")"
	return 0
}

# crypttab_cpio makes the same archive for the same crypttab, with the
# file in etc/crypttab
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_crypttab_cpio()
{
	command -v cpio > /dev/null || skip "cpio is not installed"
	load
	local tmpdir="$workdir/tmp"
	mkdir -p "$tmpdir"
	dracut_crypttab() { echo "cr_root UUID=1111 none x-initrd.attach"; }
	crypttab_cpio "$workdir/a.cpio"
	sleep 1
	crypttab_cpio "$workdir/b.cpio"
	cmp -s "$workdir/a.cpio" "$workdir/b.cpio" || fail "two archives of the same crypttab differ"
	is "content" "cr_root UUID=1111 none x-initrd.attach" "$(cpio --quiet -i --to-stdout etc/crypttab < "$workdir/a.cpio")"
	dracut_crypttab() { echo "cr_root UUID=1111 none"; }
	crypttab_cpio "$workdir/c.cpio"
	cmp -s "$workdir/a.cpio" "$workdir/c.cpio" && fail "two crypttabs give the same archive"
	return 0
}

# The initrd of an addon goes to PCR 12 after the command lines of the
# addons, as the stub measures it, and an addon without one adds nothing
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_pcrlock_addons_initrd()
{
	load
	local tmpdir="$workdir/tmp" d=/var/lib/pcrlock.d/710-kernel-cmdline-boot-loader.pcrlock.d
	local pcrlock_cache="$workdir/addons-initrd-cache"
	mkdir -p "$tmpdir"
	scratch_dir /var/lib/pcrlock.d
	mkdir -p "$d"
	echo '{"records": [{"pcr": 12, "t": "cmdline"}]}' > "$d/addons-1.pcrlock"
	echo "crypttab" > "$workdir/a.addon.efi.initrd"
	objcopy() { if [ -e "$4.initrd" ]; then cp "$4.initrd" "$5"; else : > "$5"; fi; }
	pcrlock() { local a o; for a; do [[ "$a" != --pcrlock=* ]] || o="${a#--pcrlock=}"; done; echo "{\"records\": [{\"pcr\": 12, \"t\": \"$(cat "${*: -1}")\"}]}" > "$o"; }
	pcrlock_addons_initrd 1 "$workdir/a.addon.efi" "$workdir/b.addon.efi"
	is "records" "12 cmdline|12 crypttab" "$(jq -r '.records[] | "\(.pcr) \(.t)"' "$d/addons-1.pcrlock" | paste -sd '|')"
	pcrlock_addons_initrd 2 "$workdir/b.addon.efi"
	[ -e "$d/addons-2.pcrlock" ] && fail "a variation for addons without an initrd"
	# The same initrd again comes from the cache
	pcrlock() { echo called >> "$workdir/addons-initrd-pcrlock"; return 1; }
	pcrlock_addons_initrd 3 "$workdir/a.addon.efi"
	is "cached" "12 crypttab" "$(jq -r '.records[] | "\(.pcr) \(.t)"' "$d/addons-3.pcrlock" | paste -sd '|')"
	[ ! -e "$workdir/addons-initrd-pcrlock" ] || fail "measured again"
	return 0
}

# uki_cmdline_text: with UKI_CMDLINE="no", the options of the kernel
# command line that the UKI does not have, one by one
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_uki_cmdline_text()
{
	load
	local UKI=local UKI_CMDLINE=yes
	kernel_cmdline() { echo "root=/dev/mapper/cr_root quiet resume=/dev/mapper/cr_swap"; }
	is "yes" "yes, in the addon of each entry" "$(uki_cmdline_text)"
	UKI_CMDLINE=no
	is "local" "no, not used: quiet resume=/dev/mapper/cr_swap" "$(uki_cmdline_text)"
	kernel_cmdline() { echo "root=/dev/mapper/cr_root ro"; }
	is "nothing lost" "no" "$(uki_cmdline_text)"
	return 0
}

# The addons are predicted in the order that systemd-stub loads them:
# the global ones, then the ones of the entry, each sorted by the name.
# Not in the order of the entry file
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_pcrlock_addons_order()
{
	load
	local boot_root="$workdir/esp" esp_root="$workdir/esp" tmpdir="$workdir/tmp" entryfile="$workdir/entries"
	mkdir -p "$boot_root/t" "$boot_root/loader/addons" "$tmpdir"
	scratch_dir /var/lib/pcrlock.d
	touch "$boot_root/t/uki.efi" "$boot_root/t/network-1.addon.efi" "$boot_root/t/plymouth-2.addon.efi" \
	      "$boot_root/t/cmdline-3.addon.efi" "$boot_root/loader/addons/t-dps.addon.efi"
	echo '[{"uki": "/t/uki.efi", "addons": [
		{"localAddon": "/t/network-1.addon.efi"},
		{"localAddon": "/t/plymouth-2.addon.efi", "options": "splash"},
		{"globalAddon": "/loader/addons/t-dps.addon.efi", "options": "root=x"},
		{"localAddon": "/t/cmdline-3.addon.efi", "options": "rootflags=y"}]}]' > "$entryfile"
	shift_component() { :; }
	track_esp_file() { :; }
	pcrlock_addons_initrd() { :; }
	pcrlock_addons_cmdline() { shift; echo "$*" > "$workdir/order-cmdline"; }
	pcrlock_file() { echo "${3##*/}" >> "$workdir/order-locks"; echo '{"records": []}' > "$2"; }
	pcrlock_sdboot > /dev/null 2>&1
	is "PCR 4" "uki.efi t-dps.addon.efi cmdline-3.addon.efi network-1.addon.efi plymouth-2.addon.efi" \
		"$(paste -sd ' ' "$workdir/order-locks")"
	is "PCR 12" "root=x rootflags=y splash" "$(cat "$workdir/order-cmdline")"
	return 0
}

# The kind of the next boot (a UKI or not) against the kind of this one:
# systemd measures os-separator only on the boots of a UKI
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_boot_kind_changes()
{
	load
	local entryfile="$workdir/kind-entries.json" UKI t_measured
	systemd-analyze() { [ -n "$t_measured" ]; }
	echo '[{"id": "t-commit_5.5.7.3.5-1-default.conf", "uki": "/t/u.efi"}]' > "$entryfile"

	UKI=local t_measured=""
	boot_kind_changes || fail "kernel and initrd, then a UKI: no change"
	UKI=local t_measured=1
	boot_kind_changes && fail "a UKI, then a UKI: a change"
	UKI="" t_measured=1
	echo '[{"id": "t-7.3.5-1-default-5.conf", "linux": "/t/linux"}]' > "$entryfile"
	boot_kind_changes || fail "a UKI, then kernel and initrd: no change"
	UKI="" t_measured=""
	boot_kind_changes && fail "kernel and initrd, then kernel and initrd: a change"
	return 0
}

# At a change of the kind of boot the os-separator gets an empty
# variation, next to the one of the system, and a mask of an earlier
# run goes.  Without a change, nothing of it is left
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_os_separator_variations()
{
	load
	local d=/var/lib/pcrlock.d t_change=1
	mkdir -p "$d"
	scratch_dir "$d"
	boot_kind_changes() { [ -n "$t_change" ]; }
	: > "$d/750-os-separator.pcrlock"
	os_separator_variations > /dev/null 2>&1
	is "variation" "zz-none.pcrlock" "$(cd "$d/750-os-separator.pcrlock.d" && echo *)"
	is "empty" '{"records": []}' "$(cat "$d/750-os-separator.pcrlock.d/zz-none.pcrlock")"
	[ -e "$d/750-os-separator.pcrlock" ] && fail "the mask of an earlier run stays"
	t_change=""
	os_separator_variations > /dev/null 2>&1
	[ -e "$d/750-os-separator.pcrlock.d" ] && fail "the variation stays"
