# SPDX-FileCopyrightText: Copyright 2026 SUSE LLC
#
# Unit tests for the library half of sdbootutil: the routing of the
# secrets -- which source wins, what is published to the keyring, and
# which warnings are printed -- the entry names the boot loaders spell
# differently, the versions the status report compares, `grubenv`, the
# entries that may be removed to make room in the ESP, and the files of
# the ESP that may reach a TPM2 policy.
#
# These are decisions the tool takes *before* it writes anything to the
# TPM2, so they do not need one, and they do not need a guest either: a
# scratch LUKS2 container on a loop device answers `cryptsetup` and
# `systemd-cryptenroll` exactly like a real root device does.  What
# cannot be reached from here is everything about the pcrlock NVIndex
# (authorizing with the old PIN, the "not needed, so not validated"
# skip); that needs a real TPM2 and destroys the enrollment of the
# machine it runs on, so it belongs to a guest and not to this file.
#
# `tests/run` drives the boot and FDE state of a whole guest and never
# writes outside a copy of the ESP.  This one is the opposite: it writes
# LUKS2 headers, but only the ones it made itself.
#
# Usage:
#   tests/unit [-h]
#
# Needs root, for losetup and for the keyring.  The entries it uses are
# the real ones -- the names are in the code -- so it refuses to start
# when one of them is already there, rather than overwrite a secret that
# an installer or an interrupted enrollment left behind.

set -e
shopt -s nullglob

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
top="$(dirname "$here")"

# The password of the scratch container, and the credential that
# authorizes every enrollment below
BOOTSTRAP="bootstrap-password"

# The keyring entries sdbootutil reads or writes.  Purged between cases
# so that one cannot inherit what the one before it left
KEYS=(cryptenroll sdbootutil sdbootutil-key sdbootutil-pw sdbootutil-pin
      sdbootutil-recovery-pin sdbootutil-tpm2-pin)

# A boot entry ID as `bootctl` reports it, for the entry_key cases
ENTRY="opensuse-microos-7.2.3-1-default-10"

[ "${1:-}" != "-h" ] && [ "${1:-}" != "--help" ] || {
	sed -n '4,27p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
	exit 0
}

skip()
{
	echo "SKIP: $*"
	exit 77
}

die()
{
	echo "ERROR: $*" >&2
	exit 1
}

[ "$(id -u)" = 0 ] || skip "needs root for losetup and the keyring"
for cmd in cryptsetup systemd-cryptenroll keyctl losetup jq; do
	command -v "$cmd" > /dev/null || skip "$cmd is not installed"
done
for key in "${KEYS[@]}"; do
	keyctl id %user:"$key" &> /dev/null && \
		die "%user:$key is in the keyring. Purge it first: keyctl purge user $key"
done

# The PCR 15 cases read and write fixed paths of the host (/etc/crypttab,
# /var/lib/sdbootutil, /var/lib/pcrlock.d, the measurement log).  They
# put scratch mounts over them, so everything runs in a mount namespace
# of its own, and nothing reaches the host
if [ -z "${SDBOOTUTIL_UNIT_NS:-}" ]; then
	command -v unshare > /dev/null || skip "unshare is not installed"
	exec env SDBOOTUTIL_UNIT_NS=1 unshare --mount --propagation private "${BASH_SOURCE[0]}" "$@"
fi

# The library half of sdbootutil.  Everything below the marker is the
# command dispatcher, which would run on source; everything above it is
# definitions, and the marker is already there for the completion data
lib=
dev=
workdir="$(mktemp -d -t sdbootutil-unit.XXXXXX)"

cleanup_unit()
{
	[ -z "$dev" ] || losetup -d "$dev" 2> /dev/null || true
	rm -rf "$workdir"
	purge_keys
}
trap cleanup_unit EXIT

purge_keys()
{
	local key
	for key in "${KEYS[@]}"; do
		keyctl purge user "$key" &> /dev/null || true
	done
}

extract_lib()
{
	grep -q '^####### main #######$' "$top/sdbootutil" || \
		die "the 'main' marker is gone from sdbootutil, nothing to source"
	lib="$workdir/lib.sh"
	sed '/^####### main #######$/,$d' "$top/sdbootutil" > "$lib"
	# shellcheck source=/dev/null
	( . "$lib" ) || die "the library half of sdbootutil does not source cleanly"
}

# A fresh LUKS2 header for every case, so that the slots of one do not
# reach the next.  pbkdf2 with the lowest iteration count keeps a format
# under a tenth of a second; nothing here measures key derivation
format_device()
{
	cryptsetup luksFormat --type luks2 --batch-mode \
		   --pbkdf pbkdf2 --pbkdf-force-iterations 1000 \
		   "$dev" <<<"$BOOTSTRAP"
}

setup_device()
{
	truncate -s 32M "$workdir/luks.img"
	dev="$(losetup --find --show "$workdir/luks.img")"
}

####### the assertions #######
#
# They report and continue, so that one case tells the whole story
# instead of only its first mistake.  `case_failed` is a plain variable
# because every case runs in its own subshell

fail()
{
	echo "     $*"
	case_failed=1
}

is()
{
	[ "$2" = "$3" ] || fail "$1: expected '$2', got '$3'"
}

says()
{
	case "$2" in
		*"$3"*) ;;
		*) fail "$1: '$3' was not said" ;;
	esac
}

says_not()
{
	case "$2" in
		*"$3"*) fail "$1: '$3' was said, and should not" ;;
	esac
}

key_is()
{
	local id value=
	if id="$(keyctl id %user:"$1" 2> /dev/null)"; then
		value="$(keyctl pipe "$id")"
	fi
	is "keyring %user:$1" "$2" "$value"
}

no_key()
{
	! keyctl id %user:"$1" &> /dev/null || \
		fail "keyring %user:$1 exists, and should not"
}

opens()
{
	cryptsetup luksOpen --test-passphrase --disable-external-tokens \
		   "$dev" <<<"$1" &> /dev/null || \
		fail "$2: the value does not open the device"
}

# Run "$@" with the trace of --start-trace-code going to $workdir/trace,
# as sdbootutil does it: `set -x` on a separate descriptor
traced()
{
	local fd
	: > "$workdir/trace"
	exec {fd}>> "$workdir/trace"
	BASH_XTRACEFD="$fd"
	set -x
	"$@"
	{ set +x; } 2> /dev/null
	unset BASH_XTRACEFD
	exec {fd}>&-
}

# None of the values reached the trace
not_traced()
{
	local value
	[ -s "$workdir/trace" ] || fail "trace: nothing was traced, the check proves nothing"
	for value in "$@"; do
		[ -n "$value" ] || continue
		! grep -qF -- "$value" "$workdir/trace" || \
			fail "trace: a secret was recorded ('${value:0:6}...')"
	done
}

# Source the library with whatever the case put in the environment, and
# take back the `set -e` that sdbootutil turns on: an assertion has to
# be able to fail without ending the case
load()
{
	# shellcheck source=/dev/null
	. "$lib"
	set +e
	# grubenv_set and the installers record into it, never the host's
	# shellcheck disable=SC2034  # read by the sourced library
	esp_files="$workdir/esp-files"
}

# An empty tmpfs over "dir", for the cases that use a fixed path of the
# host.  Only our own tmpfs is emptied: "dir" can be a mount point of the
# host (/.snapshots is one), and its files are not ours
scratch_dir()
{
	local dir="$1"

	# The last one is on top of the ones of the host
	scratch_mounted() { [ "$(findmnt -n -o SOURCE --mountpoint "$dir" | tail -1)" = sdbootutil-unit ]; }
	scratch_mounted || mount -t tmpfs sdbootutil-unit "$dir"
	scratch_mounted || die "$dir is not a scratch tmpfs"
	rm -rf "${dir:?}"/*
}

####### the cases #######
#
# get_device_password: every source of a *current* password, and the
# rule that a candidate is validated before it is used

t_gdp_current_pw()
{
	CURRENT_PW="$BOOTSTRAP" load

	get_device_password "$dev"
	# shellcheck disable=SC2154  # set by the sourced library
	is "returned" "$BOOTSTRAP" "$device_pw"
	key_is cryptenroll "$BOOTSTRAP"
}

t_gdp_key()
{
	KEY="$BOOTSTRAP" load

	get_device_password "$dev"
	is "returned" "$BOOTSTRAP" "$device_pw"
}

t_gdp_pw()
{
	PW="$BOOTSTRAP" load

	get_device_password "$dev"
	is "returned" "$BOOTSTRAP" "$device_pw"
}

# The recovery PIN is the recovery key while the two are linked, so the
# variable has to unlock exactly like its keyring twin below
t_gdp_recovery_pin()
{
	RECOVERY_PIN="$BOOTSTRAP" load

	get_device_password "$dev"
	is "returned" "$BOOTSTRAP" "$device_pw"
}

t_gdp_keyring_recovery_pin()
{
	load
	keyctl padd user sdbootutil-recovery-pin @u <<<"$BOOTSTRAP" > /dev/null

	get_device_password "$dev"
	is "returned" "$BOOTSTRAP" "$device_pw"
}

# %user:sdbootutil holds "any secret" and is deprecated as a name, but
# not as a candidate: it is validated like the rest
t_gdp_keyring_deprecated()
{
	load
	keyctl padd user sdbootutil @u <<<"$BOOTSTRAP" > /dev/null

	get_device_password "$dev"
	is "returned" "$BOOTSTRAP" "$device_pw"
}

t_gdp_all_wrong()
{
	CURRENT_PW="wrong-1" KEY="wrong-2" PW="wrong-3" RECOVERY_PIN="wrong-4" load

	get_device_password "$dev"
	is "returned" "" "$device_pw"
	# A wrong candidate must not displace a good entry, so nothing
	# is written when nothing validated
	no_key cryptenroll
}

t_gdp_wrong_then_valid()
{
	CURRENT_PW="wrong-1" KEY="$BOOTSTRAP" load

	get_device_password "$dev"
	is "returned" "$BOOTSTRAP" "$device_pw"
	key_is cryptenroll "$BOOTSTRAP"
}

####### enroll_recovery_key: what is enrolled, and what is published
####### as the recovery PIN

t_erk_key_env()
{
	CURRENT_PW="$BOOTSTRAP" KEY="the-recovery-key" load

	out="$(enroll_recovery_key "$dev" 2>&1)"

	opens "the-recovery-key" "enrolled key"
	# No PIN anywhere, so this key becomes one: a single secret
	key_is sdbootutil-recovery-pin "the-recovery-key"
	says_not "output" "$out" "are now different"
}

# Nothing was given: systemd-cryptenroll generates the key, it is
# printed, and it is published as the recovery PIN too
t_erk_generated()
{
	CURRENT_PW="$BOOTSTRAP" load

	out="$(enroll_recovery_key "$dev" 2>&1)"

	local key
	key="$(sed -n 's/^Recovery key: //p' <<<"$out")"
	[ -n "$key" ] || fail "output: no recovery key was printed"
	opens "$key" "generated key"
	key_is sdbootutil-recovery-pin "$key"
}

# A recovery PIN is presented and there is no recovery key yet, so the
# key enrolled is the PIN: still one secret, and the entry that holds
# the PIN is not rewritten
t_erk_recovery_pin_env()
{
	CURRENT_PW="$BOOTSTRAP" RECOVERY_PIN="the-recovery-pin" load

	out="$(enroll_recovery_key "$dev" 2>&1)"

	opens "the-recovery-pin" "enrolled key"
	says_not "output" "$out" "are now different"
}

# Both given and different: the key is enrolled, the PIN is left alone
# (it cannot be replaced) and the divergence is reported
t_erk_diverging()
{
	CURRENT_PW="$BOOTSTRAP" KEY="the-recovery-key" RECOVERY_PIN="the-recovery-pin" load

	out="$(enroll_recovery_key "$dev" 2>&1)"

	opens "the-recovery-key" "enrolled key"
	says "output" "$out" "The recovery key and the recovery PIN are now different"
	no_key sdbootutil-recovery-pin
}

# A PIN already seals an NVIndex and it is not reachable here, so this
# key is not it.  Publishing it would name as the recovery PIN a value
# that no policy update can use, and `status` would then report a PIN
# that is not there (github issue 250).  The TPM2 slot is faked because
# the answer must not depend on having a TPM2
t_erk_unreachable_pin()
{
	CURRENT_PW="$BOOTSTRAP" KEY="the-recovery-key" load

	# Called by enroll_recovery_key, from the sourced library
	# shellcheck disable=SC2329
	have_slot()
	{
		[ "$2" = "tpm2" ] && return 0
		grep -q "$2" < <(systemd-cryptenroll "$1")
	}

	out="$(enroll_recovery_key "$dev" 2>&1)"

	opens "the-recovery-key" "enrolled key"
	says "output" "$out" "There is already a recovery PIN for the TPM2"
	says "output" "$out" "The recovery key and the recovery PIN are now different"
	no_key sdbootutil-recovery-pin
}

# entry_key: the spellings a boot loader can leave in
# "LoaderEntrySelected", all reduced to the ID that `bootctl` reports.
# systemd-boot writes that ID as it is; grub2-bls drops the ".conf"
# suffix and keeps the boot counter, which it records before
# "systemd-bless-boot" renames the file

t_ek_systemd_boot()
{
	load

	is "the ID itself" "$ENTRY" "$(entry_key "$ENTRY.conf")"
}

t_ek_no_suffix()
{
	load

	is "no .conf suffix" "$ENTRY" "$(entry_key "$ENTRY")"
}

t_ek_counter()
{
	load

	is "counter alone" "$ENTRY" "$(entry_key "$ENTRY+3")"
	is "counter and suffix" "$ENTRY" "$(entry_key "$ENTRY+3.conf")"
}

t_ek_counted_boot()
{
	load

	is "one attempt counted" "$ENTRY" "$(entry_key "$ENTRY+2-1")"
}

t_ek_not_a_counter()
{
	load

	# Only "+" followed by digits is a counter, so an entry token
	# that carries one keeps it
	is "a + in the name" "my+entry-1" "$(entry_key "my+entry-1.conf")"
	is "nothing to reduce" "" "$(entry_key "")"
}

# status_version_row: the three answers that the report can give about a
# binary in the ESP, the same ones that `bootloader_needs_update` gives

t_svr_current()
{
	load

	says "row" "$(status_version_row "In the ESP" 261.2 261.2)" "up to date (261.2)"
}

t_svr_outdated()
{
	load

	says "row" "$(status_version_row "In the ESP" 258.4 261.2)" \
	     "OUTDATED: 258.4 in the ESP, 261.2 in the system"
}

t_svr_newer()
{
	load

	says "row" "$(status_version_row "In the ESP" 262 261.2)" \
	     "262, newer than the 261.2 of the system"
}

# The shim reports a major.minor that does not change between builds, so
# the modification time appended to it is what decides
t_svr_shim_mtime()
{
	load

	says "older" "$(status_version_row Shim 16.1-202506170714 16.1-202601011200)" "OUTDATED"
	says "newer" "$(status_version_row Shim 16.1-202601011200 16.1-202506170714)" "newer than"
}

t_svr_no_system()
{
	load

	says "row" "$(status_version_row Shim 16.1-202506170714 "")" \
	     "the version of the system cannot be read"
}

# grubenv_set: GRUB2 reads a block of exactly 1024 bytes, so the size is
# the whole of what the padding has to get right

t_grubenv_size()
{
	load
	# shellcheck disable=SC2034  # both are read by the sourced library
	esp_root="$workdir" esp_dst=""

	grubenv_set default opensuse-tumbleweed-7.2.3-1-default-10
	is "size" 1024 "$(stat -c %s "$workdir/grubenv")"

	grubenv_set timeout 5
	is "size after a second key" 1024 "$(stat -c %s "$workdir/grubenv")"

	is "default" opensuse-tumbleweed-7.2.3-1-default-10 "$(grubenv_get default)"
	is "timeout" 5 "$(grubenv_get timeout)"
}

# A block whose variables already fill it needs no padding at all, and
# that is where one byte used to be written anyway
t_grubenv_full()
{
	load
	# shellcheck disable=SC2034  # both are read by the sourced library
	esp_root="$workdir" esp_dst=""

	# 25 bytes of header, and a "default=" line that takes the rest
	printf '%s\n' "# GRUB Environment Block" > "$workdir/grubenv"
	printf 'default=%s\n' "$(printf '%*s' 990 "" | tr ' ' x)" >> "$workdir/grubenv"

	grubenv_set default "$(printf '%*s' 990 "" | tr ' ' y)"
	is "size" 1024 "$(stat -c %s "$workdir/grubenv")"
}

# removable_entries: the entries that make_free_space may unlink when
# the ESP is short of space.  A new snapshot reuses the initrd of an
# entry of its parent (github issue 449), and unlinking that entry frees
# the initrd the new entry is about to point at

# The ESP of a Tumbleweed where snapshot 11 is being created from 10,
# the default, which has two kernels.  Snapshot 5 is a leftover
removable_setup()
{
	load
	# shellcheck disable=SC2034  # read by the sourced library
	have_snapshots=1 root_snapshot=10 entryfile="$workdir/entries.json"

	# What reads the system: bootctl, and the snapper database
	# shellcheck disable=SC2329  # both are called by the sourced library
	update_entries_for_this_system() { :; }
	# shellcheck disable=SC2329
	snapshots_in_use() { printf '%s\n' 10 11; }

	local e=/boot/efi/loader/entries t=opensuse-tumbleweed s=@/.snapshots
	jq -n --arg e "$e" --arg t "$t" --arg s "$s" '[
		{id: "\($t)-6.1.0-1-default-5.conf", path: "\($e)/\($t)-6.1.0-1-default-5.conf",
		 options: "rootflags=subvol=\($s)/5/snapshot", linux: "/\($t)/6.1.0-1-default/linux-a"},
		{id: "\($t)-6.1.0-1-default-10.conf", path: "\($e)/\($t)-6.1.0-1-default-10.conf",
		 options: "rootflags=subvol=\($s)/10/snapshot", linux: "/\($t)/6.1.0-1-default/linux-a"},
		{id: "\($t)-6.2.0-1-default-10.conf", path: "\($e)/\($t)-6.2.0-1-default-10.conf",
		 options: "rootflags=subvol=\($s)/10/snapshot", linux: "/\($t)/6.2.0-1-default/linux-b",
		 isDefault: true}
	]' > "$entryfile"
}

t_re_order()
{
	removable_setup

	# The leftover first, the default snapshot as a last resort, and
	# never the default entry
	is "candidates" \
	   "opensuse-tumbleweed-6.1.0-1-default-5.conf opensuse-tumbleweed-6.1.0-1-default-10.conf" \
	   "$(removable_entries 11 | paste -sd' ')"
}

t_re_reused()
{
	removable_setup
	# shellcheck disable=SC2034  # read by the sourced library
	reused_entry="/boot/efi/loader/entries/opensuse-tumbleweed-6.1.0-1-default-10.conf"

	is "candidates" "opensuse-tumbleweed-6.1.0-1-default-5.conf" \
	   "$(removable_entries 11 | paste -sd' ')"
}

# pending_kernel_size: a kernel that is already in the ESP is reused, so
# it needs no space
t_pks_reused()
{
	load

	is "no kernel to copy" 0 "$(pending_kernel_size "")"
	head -c 4096 /dev/zero > "$workdir/linux"
	is "a 4K kernel" 5 "$(pending_kernel_size "$workdir/linux")"
}

# kernel_cmdline_files and create_boot_options: the kernel command line
# of an entry.  The drop-ins follow the UAPI configuration files
# specification: one with the same name in "/etc" replaces the one in
# "/usr/lib", an empty one or a symlink to "/dev/null" masks it, and all
# of them are sorted by name, wherever they are.  The whole command line
# comes from one system: the snapshot of the entry, or the running one
# when the snapshot configures nothing

# Empty scratch copies of the configuration of the running system, a
# "/proc/cmdline" with the content of "$1", and an empty snapshot in
# "$root", that is "@$root" as a subvolume
cmdline_setup()
{
	load
	local d
	for d in /etc/kernel /usr/lib/kernel; do
		[ -d "$d" ] || skip "$d is needed as a mount point"
		scratch_dir "$d"
		mkdir "$d/cmdline.d"
	done

	# Rewritten in place, so the bind mount of an earlier case sees it
	echo "${1:-BOOT_IMAGE=/vmlinuz quiet}" > "$workdir/proc-cmdline"
	grep -q ' /proc/cmdline ' /proc/self/mountinfo || \
		mount --bind "$workdir/proc-cmdline" /proc/cmdline

	root="$workdir/root"
	rm -rf "$root"
	mkdir -p "$root/etc/kernel/cmdline.d" "$root/usr/lib/kernel/cmdline.d"

	# shellcheck disable=SC2034  # read by the sourced library
	subvol_prefix="@"
	# shellcheck disable=SC2034  # read by the sourced library
	machine_id=1
	strict_vars="subvol_prefix machine_id"
	# shellcheck disable=SC2329  # called by the sourced library
	get_rootfs() { echo "UUID=1"; }
	# shellcheck disable=SC2329  # called by the sourced library
	foreign_system() { return 1; }
}

# Run a function of sdbootutil under `set -e`, like sdbootutil does.  It
# needs a shell of its own: every case is called in a `||` list, where
# bash ignores `set -e`, even when it is set again inside.  The new shell
# gets the functions of the case (the stubs too), and the variables
# named in "strict_vars"
strict()
{
	# shellcheck disable=SC2086  # a list of names
	{ declare -f; declare -p $strict_vars; } > "$workdir/strict.sh"
	# shellcheck disable=SC2016  # expanded by the new shell
	"$BASH" -c '. "$1"; . "$2"; shift 2; "$@"' _ "$lib" "$workdir/strict.sh" "$@"
}

# The files of the command line of "subvol", in one line, with "$root"
# written as "S"
cmdline_files()
{
	strict kernel_cmdline_files "$1" | sed "s|^$root/|S/|" | paste -sd' '
}

# The drop-ins that packages ship are beside "/usr/lib/kernel/cmdline"
# (github issue 467), and an empty one in "/etc" masks them
t_kcf_dropins()
{
	cmdline_setup
	echo "quiet" > "$root/etc/kernel/cmdline"
	echo "foo=1" > "$root/usr/lib/kernel/cmdline.d/10-foo.conf"
	echo "bar=1" > "$root/usr/lib/kernel/cmdline.d/20-bar.conf"
	: > "$root/etc/kernel/cmdline.d/20-bar.conf"
	echo "baz=1" > "$root/etc/kernel/cmdline.d/30-baz.conf"

	is "files" \
	   "S/etc/kernel/cmdline S/usr/lib/kernel/cmdline.d/10-foo.conf S/etc/kernel/cmdline.d/30-baz.conf" \
	   "$(cmdline_files "@$root")"
}

# The drop-ins are sorted by name, wherever they are
t_kcf_order()
{
	cmdline_setup
	echo "a=1" > "$root/usr/lib/kernel/cmdline.d/10-a.conf"
	echo "b=1" > "$root/etc/kernel/cmdline.d/20-b.conf"
	echo "c=1" > "$root/usr/lib/kernel/cmdline.d/30-c.conf"
	echo "z=1" > "$root/etc/kernel/cmdline.d/05-z.conf"

	is "files" \
	   "S/etc/kernel/cmdline.d/05-z.conf S/usr/lib/kernel/cmdline.d/10-a.conf S/etc/kernel/cmdline.d/20-b.conf S/usr/lib/kernel/cmdline.d/30-c.conf" \
	   "$(cmdline_files "@$root")"
}

# A drop-in in "/etc" takes the place of the one it replaces
t_kcf_override()
{
	cmdline_setup
	echo "a=1" > "$root/usr/lib/kernel/cmdline.d/10-a.conf"
	echo "x=1" > "$root/usr/lib/kernel/cmdline.d/20-x.conf"
	echo "c=1" > "$root/usr/lib/kernel/cmdline.d/30-c.conf"
	echo "x=2" > "$root/etc/kernel/cmdline.d/20-x.conf"

	is "files" \
	   "S/usr/lib/kernel/cmdline.d/10-a.conf S/etc/kernel/cmdline.d/20-x.conf S/usr/lib/kernel/cmdline.d/30-c.conf" \
	   "$(cmdline_files "@$root")"
}

# A symlink to "/dev/null" masks a drop-in, and the base file
t_kcf_mask_symlink()
{
	cmdline_setup
	echo "quiet" > "$root/usr/lib/kernel/cmdline"
	ln -s /dev/null "$root/etc/kernel/cmdline"
	echo "a=1" > "$root/usr/lib/kernel/cmdline.d/10-a.conf"
	ln -s /dev/null "$root/etc/kernel/cmdline.d/10-a.conf"
	echo "b=1" > "$root/usr/lib/kernel/cmdline.d/20-b.conf"

	is "files" "S/usr/lib/kernel/cmdline.d/20-b.conf" "$(cmdline_files "@$root")"
}

# An empty "/etc/kernel/cmdline" masks the one in "/usr/lib", and
# "/proc/cmdline" too, but the drop-ins are still read
t_kcf_mask_base()
{
	cmdline_setup
	: > /etc/kernel/cmdline
	echo "quiet" > /usr/lib/kernel/cmdline
	echo "a=1" > /usr/lib/kernel/cmdline.d/10-a.conf

	is "files" "/etc/kernel/cmdline /usr/lib/kernel/cmdline.d/10-a.conf" "$(cmdline_files "")"
	strict kernel_cmdline_files "" > /dev/null || fail "an empty command line is a configured one"

	rm /etc/kernel/cmdline
	is "vendor base" "/usr/lib/kernel/cmdline /usr/lib/kernel/cmdline.d/10-a.conf" "$(cmdline_files "")"
}

# Directories, hidden files, and the files that rpm and the editors
# leave behind are not drop-ins
t_kcf_not_dropins()
{
	cmdline_setup
	local d="$root/etc/kernel/cmdline.d"
	echo "a=1" > "$d/10-a.conf"
	mkdir "$d/20-dir"
	echo "x=1" > "$d/20-dir/x"
	local i
	for i in 10-a.conf.rpmsave 10-a.conf.rpmnew 10-a.conf.rpmorig 10-a.conf~ .10-a.conf.swp; do
		echo "a=2" > "$d/$i"
	done

	is "files" "S/etc/kernel/cmdline.d/10-a.conf" "$(cmdline_files "@$root")"

	# Neither are they a configuration of the snapshot of their own
	rm "$d/10-a.conf"
	echo "quiet" > /etc/kernel/cmdline
	is "running" "/etc/kernel/cmdline" "$(cmdline_files "@$root")"
}

# A snapshot that has a configuration uses only its own: the files of
# the running system are neither added nor do they mask the ones of the
# snapshot (github issue 483)
t_kcf_same_name()
{
	cmdline_setup
	echo "quiet" > "$root/etc/kernel/cmdline"
	echo "foo=1" > "$root/usr/lib/kernel/cmdline.d/10-foo.conf"
	echo "bar=1" > "$root/usr/lib/kernel/cmdline.d/20-bar.conf"

	echo "splash" > /etc/kernel/cmdline
	# The same name in both, the issue
	echo "foo=1" > /usr/lib/kernel/cmdline.d/10-foo.conf
	# Replaced and masked in the running system only
	echo "foo=2" > /etc/kernel/cmdline.d/10-foo.conf
	: > /etc/kernel/cmdline.d/20-bar.conf
	# Only in the running system
	echo "new=1" > /usr/lib/kernel/cmdline.d/30-new.conf

	is "files" \
	   "S/etc/kernel/cmdline S/usr/lib/kernel/cmdline.d/10-foo.conf S/usr/lib/kernel/cmdline.d/20-bar.conf" \
	   "$(cmdline_files "@$root")"
}

# A snapshot without any configuration takes the one of the running
# system as a whole, its masks included
t_kcf_fallback()
{
	cmdline_setup
	echo "quiet" > /etc/kernel/cmdline
	echo "a=1" > /usr/lib/kernel/cmdline.d/10-a.conf
	echo "b=1" > /usr/lib/kernel/cmdline.d/20-b.conf
	: > /etc/kernel/cmdline.d/20-b.conf

	is "files" "/etc/kernel/cmdline /usr/lib/kernel/cmdline.d/10-a.conf" "$(cmdline_files "@$root")"
	is "missing snapshot" "/etc/kernel/cmdline /usr/lib/kernel/cmdline.d/10-a.conf" \
	   "$(cmdline_files "@$workdir/missing")"
}

# A snapshot with drop-ins and no base file is a configuration: the base
# file of the running system and "/proc/cmdline" are not its own
t_kcf_no_base()
{
	cmdline_setup
	echo "a=1" > "$root/etc/kernel/cmdline.d/10-a.conf"
	echo "quiet" > /etc/kernel/cmdline

	is "files" "S/etc/kernel/cmdline.d/10-a.conf" "$(cmdline_files "@$root")"
}

# "/proc/cmdline" is the last resort of the running system, never of a
# foreign one, and without it nothing can be configured
t_kcf_proc()
{
	cmdline_setup
	echo "a=1" > /usr/lib/kernel/cmdline.d/10-a.conf

	is "running" "/proc/cmdline /usr/lib/kernel/cmdline.d/10-a.conf" "$(cmdline_files "")"
	is "snapshot" "/proc/cmdline /usr/lib/kernel/cmdline.d/10-a.conf" "$(cmdline_files "@$root")"

	# shellcheck disable=SC2329  # called by the sourced library
	foreign_system() { return 0; }
	is "foreign" "/usr/lib/kernel/cmdline.d/10-a.conf" "$(cmdline_files "")"
	rm /usr/lib/kernel/cmdline.d/10-a.conf
	strict kernel_cmdline_files "" > /dev/null && fail "nothing is configured"
}

# The snapshot that is running is "/", so "/proc/cmdline" is its last
# resort too, and its files are read once (github issue 411)
t_kcf_running()
{
	cmdline_setup
	echo "a=1" > /usr/lib/kernel/cmdline.d/10-a.conf
	echo "b=1" > /etc/kernel/cmdline.d/20-b.conf

	local running="$workdir/running"
	mkdir -p "$running"
	mount --rbind / "$running" || skip "cannot bind mount / in $running"
	is "files" "/proc/cmdline /usr/lib/kernel/cmdline.d/10-a.conf /etc/kernel/cmdline.d/20-b.conf" \
	   "$(cmdline_files "@$running")"
	umount -l "$running"
}

# The prefix of the subvolume is not always a single character
t_kcf_prefix()
{
	cmdline_setup
	echo "quiet" > "$root/etc/kernel/cmdline"
	# shellcheck disable=SC2034  # read by the sourced library
	subvol_prefix="@root"

	is "files" "S/etc/kernel/cmdline" "$(cmdline_files "@root$root")"
}

# Every line counts, the last one too when it does not end in a newline
t_cbo_newline()
{
	cmdline_setup
	printf 'quiet splash' > /etc/kernel/cmdline
	printf 'a=1\nb=1' > /etc/kernel/cmdline.d/10-a.conf

	is "options" "quiet splash a=1 b=1 root=UUID=1" "$(strict create_boot_options "")"
}

# Comments, blank lines and the spaces around a line are dropped
t_cbo_comments()
{
	cmdline_setup
	printf '# base\n  quiet  \n\n\t# indented\nsplash\n' > /etc/kernel/cmdline
	printf '# nothing but a comment\n' > /etc/kernel/cmdline.d/10-a.conf
	printf '\n  a=1 b=1\n' > /etc/kernel/cmdline.d/20-b.conf

	is "options" "quiet splash a=1 b=1 root=UUID=1" "$(strict create_boot_options "")"
}

# The entry of a snapshot boots its subvolume
t_cbo_snapshot()
{
	cmdline_setup
	echo "quiet rootflags=subvol=@/.snapshots/1/snapshot" > "$root/etc/kernel/cmdline"

	is "options" "quiet rootflags=subvol=@$root root=UUID=1" "$(strict create_boot_options "@$root")"
}

# "/proc/cmdline" already has the drop-ins of the boot, that are not
# added twice (and not once more on every boot)
t_cbo_proc()
{
	cmdline_setup 'BOOT_IMAGE=/vmlinuz root=UUID=0 quiet a=1 dyndbg="file a.c +p" old=1'
	echo "a=1" > /usr/lib/kernel/cmdline.d/10-a.conf
	echo 'dyndbg="file a.c +p"' > /usr/lib/kernel/cmdline.d/20-dyndbg.conf

	is "options" 'root=UUID=1 quiet old=1 a=1 dyndbg="file a.c +p"' "$(strict create_boot_options "")"

	# Only the drop-ins are taken out, not what looks like them
	echo "dyndbg=\"file\"" > /usr/lib/kernel/cmdline.d/20-dyndbg.conf
	is "quoted" 'root=UUID=1 quiet dyndbg="file a.c +p" old=1 a=1 dyndbg="file"' "$(strict create_boot_options "")"

	# A value in quotes is one parameter, that keeps what is inside
	cmdline_setup 'quiet opt="a b c"'
	echo "b" > /usr/lib/kernel/cmdline.d/10-b.conf
	is "inside quotes" 'quiet opt="a b c" b root=UUID=1' "$(strict create_boot_options "")"
}

# install_extra_entries: the boot entries that other packages add with
# a file in /usr/lib/sdbootutil/entries.d, that has the EFI binary
# (EFI=) and its boot entry (ENTRY=).  The files of the directory follow
# the UAPI configuration files specification, like cmdline.d

# A scratch ESP with a kernel entry, and a scratch snapshot 5 over
# "/.snapshots", in "$root", with the EFI binary /usr/share/a/a.efi and
# its boot entry /usr/share/a/a.conf
extra_setup()
{
	load
	[ -d /.snapshots ] || skip "/.snapshots is needed as a mount point"
	scratch_dir /.snapshots

	root=/.snapshots/5/snapshot
	mkdir -p "$root/usr/lib/sdbootutil/entries.d" "$root/etc/sdbootutil/entries.d" "$root/usr/share/a"
	echo "a" > "$root/usr/share/a/a.efi"
	printf 'title A\nefi /EFI/extra/a.efi\n' > "$root/usr/share/a/a.conf"

	esp="$workdir/esp"
	rm -rf "$esp"
	mkdir -p "$esp/loader/entries"
	printf 'title Linux\nlinux /a/linux\n' > "$esp/loader/entries/linux.conf"

	# shellcheck disable=SC2034  # read by the sourced library
	have_snapshots=1
	# Not "@": the prefix of the subvolume is not part of the path
	# shellcheck disable=SC2034  # read by the sourced library
	subvol_prefix="@root"
	# shellcheck disable=SC2034  # read by the sourced library
	esp_root="$esp"
	# shellcheck disable=SC2034  # read by the sourced library
	boot_root="$esp"
	# shellcheck disable=SC2034  # read by the sourced library
	entryfile="$workdir/entries.json"
	strict_vars="have_snapshots subvol_prefix esp_root boot_root entryfile esp_files"

	# The extra entries in the ESP, like `bootctl list` reports them
	# shellcheck disable=SC2329  # called by the sourced library
	update_entries_for_extra()
	{
		local f
		for f in "$boot_root"/loader/entries/*.conf; do
			awk -v path="$f" '$1 == "linux" || $1 == "efi" { printf "{\"%s\":\"%s\",\"path\":\"%s\"}\n", $1, $2, path }' "$f"
		done | jq -s '[.[]|select((.linux//.efi//"")|startswith("/EFI/extra"))]' > "$entryfile"
	}
}

# The files in the ESP, in one line
esp_state()
{
	(cd "$esp" && find . -type f | sed 's|^\./||' | sort | paste -sd' ')
}

# install_extra_entries for snapshot 5, with what it says
extras()
{
	strict install_extra_entries 5 2>&1
}

# An entries.d file installs the EFI binary and the boot entry, from the
# snapshot
t_iee_install()
{
	extra_setup
	printf 'EFI=/usr/share/a/a.efi\nENTRY=/usr/share/a/a.conf\n' > "$root/usr/lib/sdbootutil/entries.d/a.conf"

	is "said" "" "$(extras)"
	is "esp" "EFI/extra/a.efi loader/entries/a.conf loader/entries/linux.conf" "$(esp_state)"
}

# Comments, blank lines, spaces around "=" and the value, an "=" in the
# value, and a last line without a newline are all valid
t_iee_parse()
{
	extra_setup
	echo "a" > "$root/usr/share/a/a=1.efi"
	printf '# A comment\n\n  EFI = /usr/share/a/a=1.efi  \nENTRY=/usr/share/a/a.conf' > "$root/usr/lib/sdbootutil/entries.d/a.conf"

	is "said" "" "$(extras)"
	is "esp" "EFI/extra/a=1.efi loader/entries/a.conf loader/entries/linux.conf" "$(esp_state)"
}

# A line that is not KEY=VALUE is reported and skipped, the rest of the
# file is still valid
t_iee_bad_line()
{
	extra_setup
	printf 'not a key\n=value\nEFI=/usr/share/a/a.efi\n' > "$root/usr/lib/sdbootutil/entries.d/a.conf"

	local said
	said="$(extras)"
	says "not a key" "$said" 'Ignoring the line "not a key"'
	says "no key" "$said" 'Ignoring the line "=value"'
	is "esp" "EFI/extra/a.efi loader/entries/linux.conf" "$(esp_state)"
}

# A file without EFI=, or with files that are not there, installs
# nothing and is reported
t_iee_invalid()
{
	extra_setup
	local d="$root/usr/lib/sdbootutil/entries.d"
	printf 'ENTRY=/usr/share/a/a.conf\n' > "$d/10-no-efi.conf"
	printf 'EFI=/usr/share/a/missing.efi\n' > "$d/20-no-binary.conf"
	printf 'EFI=/usr/share/a/a.efi\nENTRY=/usr/share/a/missing.conf\n' > "$d/30-no-entry.conf"

	local said
	said="$(extras)"
	says "no EFI" "$said" "No EFI= in /usr/lib/sdbootutil/entries.d/10-no-efi.conf"
	says "no binary" "$said" "Missing extra entry file /usr/share/a/missing.efi"
	says "no entry" "$said" "Missing extra entry file /usr/share/a/missing.conf"
	is "esp" "loader/entries/linux.conf" "$(esp_state)"
}

# A file in /etc replaces the one with the same name in /usr/lib
t_iee_override()
{
	extra_setup
	echo "b" > "$root/usr/share/a/b.efi"
	printf 'EFI=/usr/share/a/a.efi\nENTRY=/usr/share/a/a.conf\n' > "$root/usr/lib/sdbootutil/entries.d/a.conf"
	printf 'EFI=/usr/share/a/b.efi\n' > "$root/etc/sdbootutil/entries.d/a.conf"

	extras > /dev/null
	is "esp" "EFI/extra/b.efi loader/entries/linux.conf" "$(esp_state)"
}

# An empty file in /etc, or a symlink to /dev/null, masks the one in
# /usr/lib, and what it installed is removed
t_iee_mask()
{
	extra_setup
	printf 'EFI=/usr/share/a/a.efi\nENTRY=/usr/share/a/a.conf\n' > "$root/usr/lib/sdbootutil/entries.d/a.conf"
	extras > /dev/null

	: > "$root/etc/sdbootutil/entries.d/a.conf"
	is "empty: said" "" "$(extras)"
	is "empty" "loader/entries/linux.conf" "$(esp_state)"

	rm "$root/etc/sdbootutil/entries.d/a.conf"
	extras > /dev/null
	ln -s /dev/null "$root/etc/sdbootutil/entries.d/a.conf"
	is "symlink: said" "" "$(extras)"
	is "symlink" "loader/entries/linux.conf" "$(esp_state)"
}

# What is not in entries.d anymore is removed from the ESP, and only
# that: the kernel entries stay
t_iee_remove()
{
	extra_setup
	printf 'EFI=/usr/share/a/a.efi\nENTRY=/usr/share/a/a.conf\n' > "$root/usr/lib/sdbootutil/entries.d/a.conf"
	extras > /dev/null
	echo "stray" > "$esp/EFI/extra/stray.efi"

	rm "$root/usr/lib/sdbootutil/entries.d/a.conf"
	extras > /dev/null
	is "esp" "loader/entries/linux.conf" "$(esp_state)"
}

# A boot entry that is renamed or dropped does not stay behind
t_iee_entry_changed()
{
	extra_setup
	local conf="$root/usr/lib/sdbootutil/entries.d/a.conf"
	cp "$root/usr/share/a/a.conf" "$root/usr/share/a/a2.conf"
	printf 'EFI=/usr/share/a/a.efi\nENTRY=/usr/share/a/a.conf\n' > "$conf"
	extras > /dev/null

	printf 'EFI=/usr/share/a/a.efi\nENTRY=/usr/share/a/a2.conf\n' > "$conf"
	extras > /dev/null
	is "renamed" "EFI/extra/a.efi loader/entries/a2.conf loader/entries/linux.conf" "$(esp_state)"

	printf 'EFI=/usr/share/a/a.efi\n' > "$conf"
	extras > /dev/null
	is "dropped" "EFI/extra/a.efi loader/entries/linux.conf" "$(esp_state)"
}

# Two files cannot install the same name: the first one, by name, wins,
# and stays on the next run
t_iee_same_name()
{
	extra_setup
	mkdir "$root/usr/share/b"
	echo "b" > "$root/usr/share/b/a.efi"
	printf 'EFI=/usr/share/a/a.efi\n' > "$root/usr/lib/sdbootutil/entries.d/10-a.conf"
	printf 'EFI=/usr/share/b/a.efi\n' > "$root/etc/sdbootutil/entries.d/20-b.conf"

	says "said" "$(extras)" "Skipping extra entry /etc/sdbootutil/entries.d/20-b.conf: /EFI/extra/a.efi is already installed"
	is "first" "a" "$(cat "$esp/EFI/extra/a.efi")"
	extras > /dev/null
	is "second run" "a" "$(cat "$esp/EFI/extra/a.efi")"
}

# A file that changed is copied again, one that did not is left alone
t_iee_update()
{
	extra_setup
	printf 'EFI=/usr/share/a/a.efi\nENTRY=/usr/share/a/a.conf\n' > "$root/usr/lib/sdbootutil/entries.d/a.conf"
	extras > /dev/null
	touch -d @1 "$esp/EFI/extra/a.efi" "$esp/loader/entries/a.conf"

	extras > /dev/null
	is "unchanged" "1 1" "$(stat -c %Y "$esp/EFI/extra/a.efi" "$esp/loader/entries/a.conf" | paste -sd' ')"

	echo "a2" > "$root/usr/share/a/a.efi"
	extras > /dev/null
	is "changed" "a2" "$(cat "$esp/EFI/extra/a.efi")"
	is "entry unchanged" "1" "$(stat -c %Y "$esp/loader/entries/a.conf")"
}

# verify_esp_files: only the files that sdbootutil installed in the ESP
# can reach a new TPM2 policy (github issue 465)

# A scratch ESP with an entry, a kernel and an initrd, and the record in
# the working directory instead of /var/lib/sdbootutil
esp_setup()
{
	load
	# shellcheck disable=SC2034  # read by the sourced library
	esp_files="$workdir/esp-files" esp_root="$workdir/esp" boot_root="$workdir/esp" esp_dst="/EFI/systemd" arg_force=
	rm -rf "$workdir/esp" "$esp_files"
	mkdir -p "$workdir/esp/loader/entries" "$workdir/esp/token/7.2.3"
	echo "options root=UUID=x" > "$workdir/esp/loader/entries/$ENTRY+3.conf"
	echo "kernel" > "$workdir/esp/token/7.2.3/linux-1"
	echo "initrd" > "$workdir/esp/token/7.2.3/initrd-1"

	# What `bootctl list` reports for that ESP
	# shellcheck disable=SC2329  # called by the sourced library
	bootctl_entries()
	{
		jq -n --arg path "$workdir/esp/loader/entries/$ENTRY+3.conf" \
		   '[{"type": "type1", "path": $path, "linux": "/token/7.2.3/linux-1", "initrd": ["/token/7.2.3/initrd-1"]}]'
	}
}

# What `update-predictions` hashes for the entry
esp_track()
{
	# shellcheck disable=SC2154  # set by the sourced library
	rm -f "$tmpdir/esp-files"
	track_esp_file "$(echo "$workdir"/esp/loader/entries/*.conf)"
	track_esp_file "$workdir/esp//token/7.2.3/linux-1"
	track_esp_file "$workdir/esp/token/7.2.3/initrd-1"
}

t_efk_counter()
{
	load

	is "counter" "/esp/loader/entries/$ENTRY.conf" "$(esp_file_key "/esp/loader/entries/$ENTRY+2-1.conf")"
	is "double slash" "/esp/token/linux-1" "$(esp_file_key "/esp//token/linux-1")"
	is "not an entry" "/esp/token/linux-1+3.conf" "$(esp_file_key "/esp/token/linux-1+3.conf")"
}

t_vef_seed()
{
	esp_setup

	record_esp_file "$workdir/esp/token/7.2.3/linux-1"
	[ ! -e "$esp_files" ] || fail "a writer created the record before the first prediction"

	esp_track
	echo "changed" > "$workdir/esp/token/7.2.3/initrd-1"
	( verify_esp_files ) &> /dev/null || fail "the first prediction was refused"
	is "seeded files" 3 "$(wc -l < "$esp_files")"
	is "seeded as found" "$(sha256sum < "$workdir/esp/token/7.2.3/initrd-1" | cut -d' ' -f1)" \
	   "$(esp_file_digest "$workdir/esp/token/7.2.3/initrd-1")"
}

t_vef_unchanged()
{
	esp_setup
	esp_track
	verify_esp_files &> /dev/null

	# systemd-boot counts a boot attempt, and later blesses it
	mv "$workdir/esp/loader/entries/$ENTRY+3.conf" "$workdir/esp/loader/entries/$ENTRY+2-1.conf"
	esp_track
	( verify_esp_files ) &> /dev/null || fail "a counted boot was refused"
	mv "$workdir/esp/loader/entries/$ENTRY+2-1.conf" "$workdir/esp/loader/entries/$ENTRY.conf"
	esp_track
	( verify_esp_files ) &> /dev/null || fail "a blessed entry was refused"
}

t_vef_modified()
{
	esp_setup
	esp_track
	verify_esp_files &> /dev/null

	echo "options root=UUID=x quiet" > "$workdir/esp/loader/entries/$ENTRY+3.conf"
	local out rc=0
	out="$( verify_esp_files 2>&1 )" || rc=$?
	is "exit status" 1 "$rc"
	says "error" "$out" "$workdir/esp/loader/entries/$ENTRY+3.conf"
	says_not "error" "$out" "initrd-1"
}

t_vef_new_file()
{
	esp_setup
	esp_track
	verify_esp_files &> /dev/null

	# A file that sdbootutil installs is accepted, one that appears
	# by other means is not
	echo "initrd 2" > "$tmpdir/initrd"
	install_with_rollback "$tmpdir/initrd" "$workdir/esp/token/7.2.3/initrd-2" &> /dev/null
	echo "unknown" > "$workdir/esp/token/7.2.3/initrd-3"
	esp_track
	track_esp_file "$workdir/esp/token/7.2.3/initrd-2"
	track_esp_file "$workdir/esp/token/7.2.3/initrd-3"
	local out rc=0
	out="$( verify_esp_files 2>&1 )" || rc=$?
	is "exit status" 1 "$rc"
	says "error" "$out" "initrd-3"
	says_not "error" "$out" "initrd-2"
}

t_vef_force()
{
	esp_setup
	esp_track
	verify_esp_files &> /dev/null

	echo "options root=UUID=x quiet" > "$workdir/esp/loader/entries/$ENTRY+3.conf"
	local out
	# shellcheck disable=SC2034  # read by the sourced library
	out="$( arg_force=1; verify_esp_files 2>&1 )" || fail "--force was refused"
	says "warning" "$out" "Accepting"
	( verify_esp_files ) &> /dev/null || fail "the accepted change was refused later"
}

####### --start-trace-code: the secrets stay out of the trace, and the
####### paths that keep them out still work

SECRET="trace-sentinel-9f4c2a"

t_tr_device_password()
{
	CURRENT_PW="wrong-1" KEY="$BOOTSTRAP" load

	traced get_device_password "$dev"

	is "returned" "$BOOTSTRAP" "$device_pw"
	not_traced "$BOOTSTRAP" "wrong-1"
}

t_tr_recovery_pin()
{
	RECOVERY_PIN="$SECRET" load
	local pin extra=()

	traced recovery_pin_for_policy pin extra

	is "recovery PIN" "$SECRET" "$pin"
	is "option" "--recovery-pin=yes" "${extra[*]}"
	not_traced "$SECRET"
}

# The PIN that systemd-pcrlock generates is printed, which is the point,
# and kept in the keyring, but never traced
t_tr_generated_pin()
{
	load
	# shellcheck disable=SC2034  # read by name
	local output="o-, Selected recovery PIN is: $SECRET" out

	traced show_generated_recovery_pin output > "$workdir/out"

	out="$(cat "$workdir/out")"
	says "output" "$out" "Recovery PIN: $SECRET"
	key_is sdbootutil-recovery-pin "$SECRET"
	not_traced "$SECRET"
}

# The secret reaches the environment of the command, also when the
# command is a shell function like `pcrlock`
t_tr_run_with_secret()
{
	load
