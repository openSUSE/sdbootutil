# A cached variation is written also when the directory of its
# component is gone (unenroll keeps the cache)
# shellcheck disable=SC2034,SC2329  # read and called by the sourced library
t_pcrlock_file_cache()
{
	load
	local pcrlock_cache="$workdir/cache" out="$workdir/c.pcrlock.d/linux-1.pcrlock"
	echo kernel > "$workdir/cached-kernel"
	mkdir -p "${out%/*}"
	pcrlock() { local a; for a; do [[ "$a" != --pcrlock=* ]] || echo '{"records": []}' > "${a#--pcrlock=}"; done; }
	pcrlock_file lock-pe "$out" "$workdir/cached-kernel" || fail "the first lock failed"
	rm -r "${out%/*}"
	pcrlock() { fail "not read from the cache"; }
